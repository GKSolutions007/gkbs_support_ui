@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GKBS</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
    <link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />
    <link href="~/Content/dataTables.bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="~/Content/Snackbar.css" rel="stylesheet" />
    <script src="~/Scripts/Validation.js"></script>
    <script src="~/GKBS_Grid/js/gridui.js"></script>
    <script src="~/Scripts/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/dataTables.bootstrap.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* ── NAVBAR ── */
        .top-navbar {
            background-color: #008080;
            height: 55px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            padding: 0 20px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .company-name {
            color: white;
            font-size: 15px;
            font-weight: 600;
        }

        .navbar-center {
            flex: 1;
            max-width: 480px;
            margin: 0 30px;
        }

        .search-wrapper {
            position: relative;
        }

            .search-wrapper i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255,255,255,0.7);
                font-size: 13px;
            }

        .search-box {
            width: 100%;
            padding: 8px 18px 8px 38px;
            border-radius: 25px;
            border: none;
            background: rgba(255,255,255,0.18);
            color: white;
            font-size: 13px;
            outline: none;
        }

            .search-box::placeholder {
                color: rgba(255,255,255,0.7);
            }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            font-size: 14px;
            font-weight: 500;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #005f5f;
            border: 2px solid rgba(255,255,255,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: white;
            cursor: pointer;
        }

        /* ── LAYOUT ── */
        .main-layout {
            display: flex;
            margin-top: 55px;
            height: calc(100vh - 55px);
        }

        .sidebar {
            width: 0px;
            background: #fff;
            border-right: 1px solid #e0e0e0;
            display: flex;
            flex-direction: column;
            padding-top: 10px;
            flex-shrink: 0;
            transition: width 0.3s ease;
            overflow: hidden;
            position: relative;
        }

            .sidebar.open {
                width: 25%;
            }

        /* Hamburger fixed at top - changed to span not button */
        .hamburger-btn {
            background: none;
            border: none;
            font-size: 20px;
            color: white;
            cursor: pointer;
            padding: 10px 15px;
            display: block;
            
            text-align: right;
            position: sticky; /* stays at top always */
            top: 0;
            left: 0;
            z-index: 10;
        }

        .menu-container {
            padding-top: 10px;
            width: 220px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }


        .sidebar.open .menu-container {
            opacity: 1;
            visibility: visible;
        }

        .menu-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 15px;
            cursor: pointer;
            border-radius: 6px;
            color: #333;
            font-weight: 500;
            transition: background 0.2s;
            white-space: nowrap;
        }

            .menu-header:hover {
                background: #f0f0f0;
            }

            .menu-header .arrow {
                margin-left: auto;
                font-size: 11px;
                transition: transform 0.3s;
            }

            .menu-header.open .arrow {
                transform: rotate(180deg); /* arrow flips when open */
            }

        .submenu {
            display: none;
            flex-direction: column;
            padding-left: 40px; /* indent under parent */
            background: #f9f9f9;
        }

            .submenu.open {
                display: flex;
            }

        .submenu-item {
            padding: 8px 15px;
            color: black;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            border-radius: 4px;
            white-space: nowrap;
            transition: background 0.2s, color 0.2s;
        }

            .submenu-item:hover {
                background: #e8e8e8;
                color: #1a73e8;
            }

        .content-area {
            flex: 1;
            overflow-y: auto;
            padding: 25px;
        }

        /* ── YOUR CUSTOM FORM STYLES ── */
        .input-group-custom {
            position: relative;
            margin-top: 19px;
        }

            .input-group-custom i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #a2acba;
            }

        .form-control-custom {
            width: 100%;
            padding: 6px 15px 6px 50px;
            background: #fff;
            border: 1px solid #dcdcdc;
            border-radius: 9px;
            box-sizing: border-box;
        }

        .labelup {
            position: absolute;
            top: -12px;
            left: 12px;
            background: #fff;
            padding: 0 5px;
            color: #666;
            font-size: 0.75rem;
            font-weight: 600;
            pointer-events: none;
            z-index: 5;
        }

        .is-invalid {
            border-color: #dc3545 !important;
            background-color: #fff8f8;
        }

            .is-invalid + .labelup {
                color: #dc3545 !important;
            }

        .mismatch {
            border-color: #f39c12 !important;
        }

            .mismatch + .labelup {
                color: #f39c12 !important;
            }

        .error-msg {
            color: #dc3545;
            font-size: 11px;
            font-weight: 500;
            margin: 4px 0 10px 10px;
            display: none;
        }

        .star {
            color: #dc3545;
            margin-left: 3px;
            font-weight: bold;
        }

        .btn-primary-custom {
            background: linear-gradient(45deg, #0061f2, #6900d1);
            color: white;
            border: none;
            width: 100%;
            padding: 15px;
            border-radius: 12px;
            font-weight: 600;
            margin-top: 15px;
            cursor: pointer;
        }
    </style>
    <style>

        /* Style the tab */
        .tab {
            overflow: hidden;
            border: 1px solid #ccc;
            background-color: #f1f1f1;
            width: 100%;
            /*height:40px;*/
        }

            /* Style the buttons inside the tab */
            .tab button {
                background-color: inherit;
                float: left;
                border: none;
                outline: none;
                cursor: pointer;
                padding-top: 5px;
                padding-bottom: 5px;
                padding-left: 12px;
                transition: 0.5s;
                font-size: 15px;
                border-radius: 5px;
                width: 50%;
            }

                /* Change background color of buttons on hover */
                .tab button:hover {
                    background-color: lightskyblue;
                }

                /* Create an active/current tablink class */
                .tab button.active {
                    background-color: #ccc;
                }

        /* Style the tab content */
        .tabcontent {
            display: none;
            /*padding: 6px 12px;*/
            border: none;
            border-top: none;
        }
    </style>
    <style>
        ul {
            list-style-type: none;
            padding-left: 20px;
            margin: 0;
            font-size: 16px; /* 🔹 Font size for UL */
        }

        li {
            margin: 4px 0;
            cursor: pointer;
            user-select: none;
            font-size: 11px; /* 🔹 Font size for LI */
        }

        .toggle {
            margin-right: 6px;
            font-weight: bold;
            color: #007acc;
        }

        .collapsed {
            display: none;
        }

        span.menu-name {
            font-weight: normal;
        }
    </style>
</head>
<body>
    @{
        string User = Convert.ToString(Session["LoginUser"]);
        string UIDs = Convert.ToString(Session["LoginUserID"]);
        System.Data.DataTable dtParent = (System.Data.DataTable)Session["dtParent"];
        System.Data.DataTable dtPermission = (System.Data.DataTable)Session["dtPermission"];

        <div class="toastBox"></div>

        <nav class="top-navbar">
            <span class="hamburger-btn" onclick="toggleSidebar()" title="Menu">
                <i class="fa fa-bars"></i>
            </span>
            <a href="~/Home" style="text-decoration: none; display: flex;">
                <div class="navbar-left" style="cursor: pointer;">

                    <img src="~/Content/Images/Logo.png" alt="Logo" style="height:28px;" onerror="this.style.display='none'" />
                    <span class="company-name">GK BUSINESS &amp; SOLUTIONS</span>
                </div>
            </a>

        </nav>

        <div class="main-layout">
            <div class="sidebar" id="sidebar">
                
                <div class="tab">
                    <button class="tablinks active" id="tabCD" onclick="openTabs(event, 'ReportDetails')">Reports</button>
                    <button class="tablinks" onclick="openTabs(event, 'FilterDetails')">Filters</button>
                </div>
                <div id="ReportDetails" class="tabcontent">
                    <div id="menuContainer"></div>
                </div>
                <div id="FilterDetails" class="tabcontent" style="color: black; padding-left: 10px">
                    <h4 id="RepMainHeading">Reports</h4>
                    <div id="dvAssign" style="width:100%;padding-bottom:7px">
                        <table style="width: 100%" id="tblFilterData">
                            <thead>
                                <tr>
                                    <th style="text-align:center;font-size: 12px;width:40%;"><u>Filter Name </u></th>
                                    <th style="text-align:center;font-size: 12px;width:60%;"><u>Filter Value </u></th>
                                </tr>
                            </thead>
                        </table>
                        <div style="padding-top:5px" align="right">
                            <button type="button" class="btn btn-primary d-none" id="btnScript"><span class="glyphicon glyphicon-file"> Script</span></button>
                            <button type="button" class="btn btn-danger" id="btnClear" tabindex="5"><span class="glyphicon glyphicon-refresh"> Clear</span></button>
                            <button type="button" class="btn btn-success" id="btnPopupGenerate" tabindex="4"><span class="glyphicon glyphicon-import"> Generate</span></button>
                            @*<button type="button" class="btn btn-warning" id="btnClose" tabindex="6"><i class="bi bi-x-circle"></i> Close</button>*@
                        </div>
                    </div>
                </div>
            </div>
            <script>
                var Table = $('#tblFilterData').DataTable({
                    "bFilter": false,
                    "bSearchable": false,
                    "bInfo": false,
                    "bPaginate": false,
                    "ordering": false,
                    //scrollY: "400px",
                    //scrollX: true,
                    //scrollCollapse: true,
                });
            </script>
            <div class="content-area">
                @RenderBody()
            </div>
        </div>
    }

    <script>
        $(document).ready(function () {
            var uid = '@Session["LoginUserID"]';
            var uname = '@Session["LoginUser"]';
            
            $("#lblUserName, #dropUserName").text(uname);
            $("#avatarIcon").text(uname.charAt(0).toUpperCase());
            //if (!uid) { window.location.href = '/Login/Index'; }

            // Attach validation listeners
            var cpInputs = document.querySelectorAll('#changePasswordModal .form-control-custom');
            cpInputs.forEach(function (input) {
                input.addEventListener('blur', function () { validateCPField(this); });
                input.addEventListener('input', function () {
                    this.classList.remove('is-invalid', 'mismatch');
                    var err = document.getElementById('err_' + this.id);
                    if (err) err.style.display = 'none';
                });
            });
        });

        function toggleSidebar() {
            const sidebar = $('#sidebar');
            const icon = $('.hamburger-btn i');

            sidebar.toggleClass('open');

            if (sidebar.hasClass('open')) {
                icon.attr('class', 'fa fa-times');
            } else {
                icon.attr('class', 'fa fa-bars');
            }
        }
        function toggleProfileMenu() { var dd = document.getElementById('profileDropdown'); dd.style.display = dd.style.display === 'none' ? 'block' : 'none'; }

        function toggleSubMenu(header) {
            const submenu = header.nextElementSibling;

            document.querySelectorAll('.submenu.open').forEach(s => {
                if (s !== submenu) {
                    s.classList.remove('open');
                    s.previousElementSibling.classList.remove('open');
                }
            });

            // toggle this one
            submenu.classList.toggle('open');
            header.classList.toggle('open');
        }

        document.addEventListener('click', function (e) {
            var avatar = document.getElementById('avatarIcon');
            var dd = document.getElementById('profileDropdown');
            if (avatar && dd && !avatar.contains(e.target) && !dd.contains(e.target)) { dd.style.display = 'none'; }
        });

        function openChangePassword() {
            document.getElementById('profileDropdown').style.display = 'none';
            new bootstrap.Modal(document.getElementById('changePasswordModal')).show();
        }

        function ChangePassword() {
            var inputs = document.querySelectorAll('#changePasswordModal .form-control-custom');
            var isValid = true;
            inputs.forEach(function(input) { validateCPField(input); if (input.classList.contains('is-invalid')) isValid = false; });
            if (document.getElementById('cpConfirmPassword').classList.contains('mismatch')) isValid = false;
            if (!isValid) return;

            var Aurl = '@Session["APIurl"]';
            $.post(Aurl + "login/resetpassword", {
                UserID: sessionStorage.getItem("userID"),
                Password: $("#cpNewPassword").val()
            }, function (res) {
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                    $("#cpNewPassword, #cpConfirmPassword").val("");
                }
            });
        }

        function validateCPField(el) {
            var val = el.value.trim();
            var errDiv = document.getElementById('err_' + el.id);
            var isValid = (val !== "");
            if (!isValid) {
                el.classList.add('is-invalid');
                if (errDiv) { errDiv.innerText = "This field is required"; errDiv.style.display = 'block'; }
            } else {
                el.classList.remove('is-invalid');
                if (errDiv) errDiv.style.display = 'none';
            }
            if (el.id === "cpConfirmPassword" || el.id === "cpNewPassword") {
                var p1 = document.getElementById('cpNewPassword').value;
                var p2 = document.getElementById('cpConfirmPassword').value;
                if (p1 && p2 && p1 !== p2) {
                    document.getElementById('cpConfirmPassword').classList.add('mismatch');
                    document.getElementById('err_cpConfirmPassword').style.display = 'block';
                }
            }
        }
        addModuleIcons();
        function addModuleIcons() {
            // Icon mapping for common modules
            const moduleIcons = {
                'master': 'fas fa fa-database',
                'transactions': 'fas fa-shopping-bag',
                'reports': 'fas fa-chart-bar',
                'tools': 'fas fa-tools',
                'favourite': 'fa-regular fa-star',
            };

            // Find all dropdown buttons and menu items
            $('.menu-text').each(function () {
                const $element = $(this);
                let text = $element.text().trim().toLowerCase();

                // Check if icon already exists
                if ($element.find('i.fas, i.fa').length > 0) {
                    return; // Skip if icon already present
                }

                // Find matching icon
                let iconClass = null;
                for (let key in moduleIcons) {
                    if (text == key) {//text.includes(key)
                        iconClass = moduleIcons[key];
                        break;
                    }
                }

                // Add icon if found
                if (iconClass) {
                    $element.prepend('<i class="' + iconClass + '" style="margin-right: 8px; font-size: 13px;"></i>');
                }
            });
        }
        function Logout() { sessionStorage.clear(); window.location.href = '@Url.Action("Index", "Login")'; }
    </script>
    @RenderSection("scripts", required: false)
</body>

</html>
<script>
    window.onload = function (e) {
        // simulate a fake event if your function expects it
        openTabs(null, 'ReportDetails', 1);
        if (typeof FID !== "undefined" && FID > 0) {
            openTabs(e, 'FilterDetails', 1);
        }
    };
    function openTabs(evt, TabName, opentype = 0) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(TabName).style.display = "block";
        if (opentype == 0) {
            evt.currentTarget.className += " active";
        } else {
            document.getElementById(TabName).className += " active";
        }
    }
</script>