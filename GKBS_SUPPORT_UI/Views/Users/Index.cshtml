    <script>
        const Aurl = '@Session["APIurl"]';
        console.log("AURL Value: ", Aurl)

        const addModal = new bootstrap.Modal(document.getElementById('addUserModal'));

        //$('#btnAddUser').click(function () {
        //    document.getElementById('hdnCustomerID').value = "0";
        //    const chkActive = document.getElementById('chkActive');
        //    chkActive.checked = true;
        //    chkActive.disabled = true;
        //    addModal.show();
        //});

        document.getElementById('btnClose').addEventListener('click', function () {
            ['txtUserID', 'Signuppassword', 'SignupMobNo', 'txtFile',
                'txtUserName', 'SignupConfirmpassword', 'forgotEmail', 'txtEmpNo',
                'chkActive'
            ].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.disabled = false;
            });

            document.querySelectorAll('input[name="shineType"], input[name="userType"]')
                .forEach(r => r.disabled = false);

            // Show buttons back
            document.getElementById('btnSave').style.display = 'block';
            document.getElementById('btnClear').style.display = 'block';
            document.getElementById('txtFile').value = '';
            renderUserAttachmentGrid([])

            addModal.hide();
        });

        const allGridActions = [
            {
                icon: '✏️',
                title: 'Edit',
                displayType: 'single_icon',
                handler: function (row) {
                    fetchAndOpenUserModal(row.ID, 'edit');
                }
            },
            {
                icon: '👁️',
                title: 'View',
                displayType: 'single_icon',
                handler: function (row) {
                    fetchAndOpenUserModal(row.ID, 'view');
                }
            }
        ];
        var UserColumns = [];
        const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
        const menuActions = [];
        let userList = [];

        var actions = {
            "header": "Action",
            "type": "action",
            "width": 80,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": allGridActions
        };

        GetColumnSettingsData(2, 4, 1);

            $(document).ready(function () {
                loadDashboardGrid(1002, 1, '#grid-Users-lists', "uspgetuserslist", "", UserColumns);

    });

    function loadDashboardGrid(reportId, tableId, selector, apiEndpoint, headings, columns) {

    const userId = '@Session["LoginUserID"]';

        $.get(Aurl + "users/GetUserList", function (rowData) {
            console.log("Row Data:", rowData);
        console.log("Row Data for " + apiEndpoint, rowData);
            new GKBSDynamicGrid('#grid-Users-lists', UserColumns, rowData, {
            enablePagination: true,
            pageSize: 10,
            height: "400px",
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
                searchTerm: "",
                ReportName: "Customer",
            CompanyName: "GKBS Support",
                ReportName: "User Lists",
                customButtons: [
                    {
                        icon: '➕',
                        text: 'Add New',
                        title: 'ADD',
                        onClick: function () {
                            document.getElementById('hdnCustomerID').value = "0";
                            const chkActive = document.getElementById('chkActive');
                            chkActive.checked = true;
                            chkActive.disabled = true;
                            loadUserAttachmentsEmpty();
                            addModal.show();
                        }
                    }
                ],
                singleIconAction: singleIconAction, // Pass the single View action
                rowActionsMenu: menuActions,
                customCellRenderer: (el, col, rowData) => {
                    if (col.field === 'Active') {
                        const val = rowData[col.field];
                        console.log("Active : ", val);
                        if (val === 'True') {
                            el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                        } else if (val === 'False') {
                            el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                        }
                    }
                },

        });
    }).fail(function(xhr) {
        console.error("Row Data FAILED for " + apiEndpoint, xhr.status, xhr.responseText);
    });
    }

        function save() {
            if (!validateAll()) return;

            const userId = '@Session["LoginUserID"]';
            const ID = document.getElementById('hdnCustomerID').value;

            const payload = {
                ID: ID,
                UserID: document.getElementById('txtUserID').value.trim(),
                UserName: document.getElementById('txtUserName').value.trim(),
                Password: document.getElementById('Signuppassword').value.trim(),
                Mobilenumber: document.getElementById('SignupMobNo').value.trim(),
                EMailID: document.getElementById('forgotEmail').value.trim(),
                EmployeeNo: document.getElementById('txtEmpNo').value.trim(),
                Active: document.getElementById('chkActive').checked ? "1" : "0",
                CBy: userId
            };

            $.ajax({
                url: Aurl + "Users/Save",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res && res.length > 0 && res[0].Status === "Success") {
                        uploadUserAttachment(res[0].ID);
                        showSuccessSnackbar(res[0].Message);
                        addModal.hide();
                        document.getElementById('btnClear').click();
                        loadDashboardGrid(1002, 1, '#grid-Users-lists', "uspgetuserslist", "", UserColumns);
                    } else {
                        showErrorSnackbar((res[0] ? res[0].Message : "Something went wrong"));
                    }
                },
                error: function (xhr) {
                    showErrorSnackbar("Error: " + xhr.responseText);
                }
            });
        }


        function fetchAndOpenUserModal(id, mode) {
            $.ajax({
                url: Aurl + "Users/GetUserByID",
                type: "GET",
                data: { ID: id },
                success: function (res) {
                    if (!res.success) {
                        showErrorSnackbar(res.message || "Failed to load user.");
                        return;
                    }

                    const row = res.user;

                    // ── Populate all fields ──
                    document.getElementById('hdnCustomerID').value = row.ID;
                    document.getElementById('txtUserID').value = row.UserID || '';
                    document.getElementById('txtUserName').value = row.UserName || '';
                    document.getElementById('Signuppassword').value = row.Password || '';
                    document.getElementById('SignupConfirmpassword').value = row.Password || '';
                    document.getElementById('SignupMobNo').value = row.Mobilenumber || '';
                    document.getElementById('forgotEmail').value = row.EMailID || '';
                    document.getElementById('txtEmpNo').value = row.EmployeeNo || '';

                    const chkActive = document.getElementById('chkActive');
                    chkActive.checked = (row.Active === '1' || row.Active === 'True');

                    const allFields = [
                        'txtUserID', 'txtUserName', 'Signuppassword',
                        'SignupConfirmpassword', 'SignupMobNo', 'forgotEmail', 'txtEmpNo'
                    ];

                    if (mode === 'edit') {
                        allFields.forEach(id => {
                            const el = document.getElementById(id);
                            if (el) el.disabled = false;
                        });
                        chkActive.disabled = false;

                        document.querySelector('.modal-title').textContent = 'Edit User';
                        document.getElementById('btnSave').style.display = 'block';
                        document.getElementById('btnClear').style.display = 'block';
                        loadUserAttachments(row.ID);

                    } else if (mode === 'view') {
                        allFields.forEach(id => {
                            const el = document.getElementById(id);
                            if (el) el.disabled = true;
                        });
                        chkActive.disabled = true;

                        document.querySelector('.modal-title').textContent = 'View User';
                        document.getElementById('btnSave').style.display = 'none';
                        document.getElementById('btnClear').style.display = 'none';
                        loadUserAttachments(row.ID);
                    }

                    addModal.show();
                },
                error: function (xhr) {
                    showErrorSnackbar("Failed to load user: " + xhr.responseText);
                }
            });
        }


        // ── Load attachment grid (saved files from DB) ──
function loadUserAttachments(userID) {
    $.ajax({
        url: Aurl + "Users/GetAttachments",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ UserID: userID }),
        success: function (res) {
            const rowData = (res.success && res.files.length > 0)
                ? res.files.map(f => ({
                    ID: f.ID,
                    FileName: f.FileName,
                    FileType: f.FileType.toUpperCase(),
                    FileSize: f.FileSize >= 1024 * 1024
                        ? (f.FileSize / (1024 * 1024)).toFixed(1) + ' MB'
                        : (f.FileSize / 1024).toFixed(1) + ' KB',
                    UploadedOn: new Date(f.UploadedOn).toLocaleDateString('en-IN', {
                        day: '2-digit', month: 'short', year: 'numeric'
                    })
                }))
                : [];
            renderUserAttachmentGrid(rowData);
        },
        error: function () { showErrorSnackbar("Failed to load attachments."); }
    });
}

// ── Empty grid on Add New ──
function loadUserAttachmentsEmpty() {
    renderUserAttachmentGrid([]);
}

// ── Render the attachment grid ──
function renderUserAttachmentGrid(rowData) {
    const columns = [
        { field: "FileName",   header: "File Name",    type: "label", width: 120, align: "left",   visible: true, EnableColumnMenu: false, ShowinColumnOption: true },
        { field: "FileType",   header: "Type",         type: "label", width: 50,  align: "left",   visible: true, EnableColumnMenu: false, ShowinColumnOption: true },
        { field: "FileSize",   header: "Size",         type: "label", width: 70,  align: "left",   visible: true, EnableColumnMenu: false, ShowinColumnOption: true },
        { field: "UploadedOn", header: "Uploaded On",  type: "label", width: 90,  align: "left",   visible: true, EnableColumnMenu: false, ShowinColumnOption: true },
        { field: "Action",     header: "Action",       type: "action",width: 80,  align: "center", visible: true, specialColumn: true, ShowinColumnOption: false, EnableColumnMenu: false }
    ];

    new GKBSDynamicGrid('#grid-UserAttachment-lists', columns, rowData, {
        enablePagination: false,
        enableSearch:     false,
        enableExport:     false,
        enablePrint:      false,
        enableColumnsBtn: false,
        enableAddRow:     false,
        enableRemoveRow:  false,
        enableSorting:    false,
        height: "150px",
        singleIconAction: [
            {
                icon: '👁️', title: 'View', displayType: 'single_icon',
                handler: function (row) {
                    if (row.ID > 0) viewUserAttachment(row.ID);
                    else showErrorSnackbar('Save first to view!');
                }
            },
            {
                icon: '⬇️', title: 'Download', displayType: 'single_icon',
                handler: function (row) {
                    if (row.ID > 0) downloadUserAttachment(row.ID, row.FileName);
                    else showErrorSnackbar('Save first to download!');
                }
            },
            {
                icon: '🗑️', title: 'Delete', displayType: 'single_icon',
                handler: function (row) {
                    if (row.ID > 0) {
                        deleteUserAttachment(row.ID);
                    } else {
                        // Remove from file input preview
                        const fileInput = document.getElementById('txtFile');
                        const dt = new DataTransfer();
                        Array.from(fileInput.files).forEach(f => {
                            if (f.name !== row.FileName) dt.items.add(f);
                        });
                        fileInput.files = dt.files;
                        previewUserSelectedFiles(fileInput);
                    }
                }
            }
        ]
    });
}

// ── Preview before save ──
function previewUserSelectedFiles(input) {
    const files = Array.from(input.files);

    const gridEl = document.querySelector('#grid-UserAttachment-lists');
    const gi = gridEl ? gridEl._gkbsGrid : null;
    const existingRows = gi ? gi.originalData.filter(r => r.ID > 0) : [];

    const newRows = files.map(file => ({
        ID: 0,
        FileName: file.name,
        FileType: file.name.split('.').pop().toUpperCase(),
        FileSize: file.size >= 1024 * 1024
            ? (file.size / (1024 * 1024)).toFixed(1) + ' MB'
            : (file.size / 1024).toFixed(1) + ' KB',
        UploadedOn: 'Pending...'
    }));

    renderUserAttachmentGrid([...existingRows, ...newRows]);
}

// ── Upload after save ──
function uploadUserAttachment(userID) {
    const fileInput = document.getElementById('txtFile');
    if (!fileInput || fileInput.files.length === 0) return;

    for (let i = 0; i < fileInput.files.length; i++) {
        if (fileInput.files[i].size > 5 * 1024 * 1024) {
            showErrorSnackbar(`${fileInput.files[i].name} exceeds 5MB limit!`);
            return;
        }
    }

    const formData = new FormData();
    formData.append('UserID', userID);
    formData.append('UID', '@Session["LoginUserID"]');
    for (let i = 0; i < fileInput.files.length; i++) {
        formData.append('files', fileInput.files[i]);
    }

    $.ajax({
        url: Aurl + "Users/SaveAttachment",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            if (res[0].Status === "Success") {
                showSuccessSnackbar("Files uploaded!");
                loadUserAttachments(userID);
            } else {
                showErrorSnackbar(res[0].Message);
            }
        },
        error: function (xhr) { showErrorSnackbar("Upload error: " + xhr.responseText); }
    });
}

function viewUserAttachment(id) {
    $.ajax({
        url: Aurl + "Users/DownloadAttachment",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ ID: id }),
        xhrFields: { responseType: 'blob' },
        success: function (data) { window.open(URL.createObjectURL(data), '_blank'); },
        error: function () { showErrorSnackbar("View failed!"); }
    });
}

function downloadUserAttachment(id, fileName) {
    $.ajax({
        url: Aurl + "Users/DownloadAttachment",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ ID: id }),
        xhrFields: { responseType: 'blob' },
        success: function (data) {
            const a = document.createElement('a');
            a.href = URL.createObjectURL(data);
            a.download = fileName;
            a.click();
        },
        error: function () { showErrorSnackbar("Download failed!"); }
    });
}

function deleteUserAttachment(id) {
    if (!confirm("Delete this file?")) return;
    const userID = document.getElementById('hdnCustomerID').value;
    $.ajax({
        url: Aurl + "Users/DeleteAttachment",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ ID: id }),
        success: function (res) {
            if (res.success) { showSuccessSnackbar("Deleted!"); loadUserAttachments(userID); }
            else showErrorSnackbar(res.message);
        },
        error: function () { showErrorSnackbar("Delete failed!"); }
    });
}

        function showErr(errId, msg) {
            const el = document.getElementById(errId);
            if (el) {
                el.textContent = msg;
                el.style.display = 'block';
            }
        }

        function hideErr(errId) {
            const el = document.getElementById(errId);
            if (el) el.style.display = 'none';
        }

        function setError(inputId) {
            const el = document.getElementById(inputId);
            if (el) {
                el.style.border = '1.5px solid #dc3545';
                el.style.boxShadow = '0 0 0 3px rgba(220,53,69,0.15)';
            }
        }

        function setValid(inputId) {
            const el = document.getElementById(inputId);
            if (el) {
                el.style.border = '1.5px solid #28a745';
                el.style.boxShadow = '0 0 0 3px rgba(40,167,69,0.12)';
            }
        }


        function validateRequired(inputId, errId, label) {
            const el = document.getElementById(inputId);
            if (!el) return true;
            const val = el.value.trim();
            if (!val) {
                showErr(errId, label + ' is required');
                setError(inputId);
                return false;
            }
            hideErr(errId);
            setValid(inputId);
            return true;
        }

        function validateMobile() {
            const el = document.getElementById('SignupMobNo');
            const val = el.value.trim();
            if (!val) {
                showErr('err_SignupMobNo', 'Mobile No is required');
                setError('SignupMobNo');
                return false;
            } else if (!/^\d{10}$/.test(val)) {
                showErr('err_SignupMobNo', 'Enter valid 10 digit number');
                setError('SignupMobNo');
                return false;
            }
            hideErr('err_SignupMobNo');
            setValid('SignupMobNo');
            return true;
        }

        function validateEmail() {
            const el = document.getElementById('forgotEmail');
            const val = el.value.trim();
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/; // @@ for .NET Razor
            if (!val) {
                showErr('err_forgotEmail', 'Email Address is required');
                setError('forgotEmail');
                return false;
            } else if (!emailRegex.test(val)) {
                showErr('err_forgotEmail', 'Invalid email format');
                setError('forgotEmail');
                return false;
            }
            hideErr('err_forgotEmail');
            setValid('forgotEmail');
            return true;
        }

        function validateConfirmPassword() {
            const p1 = document.getElementById('Signuppassword').value.trim();
            const p2 = document.getElementById('SignupConfirmpassword').value.trim();
            if (!p2) {
                showErr('err_SignupConfirmpassword', 'Confirm Password is required');
                setError('SignupConfirmpassword');
                return false;
            } else if (p1 !== p2) {
                showErr('err_SignupConfirmpassword', 'Passwords do not match');
                setError('SignupConfirmpassword');
                return false;
            }
            hideErr('err_SignupConfirmpassword');
            setValid('SignupConfirmpassword');
            return true;
        }

        function validateAll() {
            let ok = true;
            if (!validateRequired('txtUserID', 'err_UserID', 'User ID')) ok = false;
            if (!validateRequired('txtUserName', 'err_UserName', 'User Name')) ok = false;
            if (!validateRequired('Signuppassword', 'err_Password', 'Password')) ok = false;
            if (!validateConfirmPassword()) ok = false;
            if (!validateMobile()) ok = false;
            if (!validateEmail()) ok = false;
            return ok;
        }

        // --- 3. Live Attachment Helper ---
        function attachLiveValidation(inputId, errId, label, customFn) {
            const el = document.getElementById(inputId);
            if (!el) return;
            const run = () => customFn ? customFn() : validateRequired(inputId, errId, label);
            el.addEventListener('blur', run);
            el.addEventListener('input', run);
        }


        document.addEventListener('DOMContentLoaded', function () {
            // Attach Live Events
            attachLiveValidation('txtUserID', 'err_UserID', 'User ID');
            attachLiveValidation('txtUserName', 'err_UserName', 'User Name');
            attachLiveValidation('Signuppassword', 'err_Password', 'Password');
            attachLiveValidation('SignupConfirmpassword', 'err_SignupConfirmpassword', 'Confirm', validateConfirmPassword);
            attachLiveValidation('SignupMobNo', 'err_SignupMobNo', 'Mobile', validateMobile);
            attachLiveValidation('forgotEmail', 'err_forgotEmail', 'Email', validateEmail);

            // Mobile Digit Restrictor
            const mobEl = document.getElementById('SignupMobNo');
            if (mobEl) {
                mobEl.addEventListener('keypress', (e) => {
                    if (!/[0-9]/.test(e.key)) e.preventDefault();
                });
            }

            document.getElementById('Signuppassword').addEventListener('input', function () {
                if (document.getElementById('SignupConfirmpassword').value) validateConfirmPassword();
            });


            const btnClear = document.getElementById('btnClear');
            if (btnClear) {
                btnClear.addEventListener('click', function () {
                    document.querySelectorAll('.form-control-custom').forEach(el => {
                        el.style.border = '1.5px solid #ced4da';
                        el.style.boxShadow = 'none';
                        el.value = '';
                    });
                    document.querySelectorAll('[id^="err_"]').forEach(el => el.style.display = 'none');

                    document.getElementById('txtFile').value = '';
                    renderUserAttachmentGrid([])
                });
            }

            // ✅ ADD THIS — auto-reset when modal closes (X button, Close button, Escape key)
            const modal = document.getElementById('addUserModal');
            if (modal) {
                modal.addEventListener('hidden.bs.modal', function () {
                    // Reset hidden ID
                    document.getElementById('hdnCustomerID').value = '0';

                    // Clear all fields
                    ['txtUserID', 'txtUserName', 'Signuppassword', 'SignupConfirmpassword',
                        'SignupMobNo', 'forgotEmail', 'txtEmpNo'].forEach(function (id) {
                            const el = document.getElementById(id);
                            if (el) {
                                el.value = '';
                                el.disabled = false;
                                el.style.border = '1.5px solid #ced4da';
                                el.style.boxShadow = 'none';
                            }
                        });

                    // Reset checkbox
                    const chkActive = document.getElementById('chkActive');
                    chkActive.checked = true;
                    chkActive.disabled = false;

                    // Reset file input and attachment grid
                    document.getElementById('txtFile').value = '';
                    renderUserAttachmentGrid([]);

                    // Reset modal title
                    document.querySelector('.modal-title').textContent = 'Add User';

                    // Show save/clear buttons
                    document.getElementById('btnSave').style.display = 'block';
                    document.getElementById('btnClear').style.display = 'block';

                    // Hide all error messages
                    document.querySelectorAll('[id^="err_"]').forEach(el => el.style.display = 'none');
                });
            }

        });

        function GetColumnSettingsData(nMode, nFormID, nTableID) {
            $.ajax({
                url: Aurl + "columnsettings/getcolumnsettings",
                type: 'get',
                contentType: 'json',
                data: { Mode: nMode, FormID: nFormID, TableID: nTableID, FormorReport: 0 },
                async: false,
                success: function (data) {
                    console.log("API Response:", data);
                    console.log("Data length:", data.length);
                    if (data.length > 0) {
                        UserColumns = (data);
                        console.log("columns : ", UserColumns);
                        UserColumns.push(actions);
                    } else {
                        showErrorSnackbar("No column data found");
                    }
                }
            });
        }

    </script>

