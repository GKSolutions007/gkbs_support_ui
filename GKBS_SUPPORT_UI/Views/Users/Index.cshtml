    <style>
        .top-bar {
            display: flex;
            justify-content: space-between; /* left and right */
            align-items: center;
            padding: 10px 20px;
            margin-bottom: 15px;
        }

        .breadcrumb-row {
            font-size: 13px;
            color: #888;
            margin-bottom: 5px;
        }

        .breadcrumb-home {
            color: #1a73e8;
        }

        .top-bar-left h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
        }

        .top-bar-right {
            display: flex;
            gap: 10px;
        }

        .btn-print {
            background: white;
            border: 1px solid #ccc;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-add {
            background: #1a73e8;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-print:hover {
            background: #f0f0f0;
        }

        .btn-add:hover {
            background: #1558b0;
        }

        /* Validation Colors */
        .is-invalid {
            border-color: var(--error-red) !important;
            background-color: #fff8f8;
        }

            .is-invalid + .labelup {
                color: var(--error-red) !important;
            }
        /* ============================================================
   User MODAL - COMPLETE CSS
   ============================================================ */
        /* Modal Size */
        .modal-xl {
            max-width: 1100px;
        }

        .modal-content {
            border-radius: 12px;
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        }

        /* Header */
        .modal-header {
            background: linear-gradient(135deg, #1a6e3c, #28a745);
            color: white;
            border-radius: 12px 12px 0 0;
            padding: 16px 24px;
        }

        .modal-title {
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .modal-header .btn-close {
            filter: invert(1);
        }

        /* Footer */
        .modal-footer {
            background: #f8f9fa;
            border-top: 1px solid #e0e0e0;
            border-radius: 0 0 12px 12px;
            padding: 12px 24px;
            gap: 10px;
        }

        /* ── Input Group ── */
        .input-group-custom {
            position: relative;
            margin-bottom: 6px;
            margin-top: 14px;
        }

        .form-control-custom {
            width: 100%;
            padding: 10px 12px 10px 36px;
            font-size: 14px;
            border: 1.5px solid #ced4da;
            border-radius: 8px;
            background: #fff;
            color: #333;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            font-family: inherit;
        }

            .form-control-custom:focus {
                border-color: #28a745;
                box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.15);
            }

        /* input without icon (dates, file, textarea) */
        input[type="date"].form-control-custom,
        input[type="file"].form-control-custom,
        textarea.form-control-custom {
            padding-left: 12px;
        }

        /* Floating Label */
        .labelup {
            position: absolute;
            top: -10px;
            left: 10px;
            font-size: 11px;
            font-weight: 600;
            color: #555;
            background: #fff;
            padding: 0 5px;
            pointer-events: none;
            letter-spacing: 0.3px;
        }

        /* Icon inside input */
        .input-group-custom > i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #888;
            font-size: 13px;
            z-index: 1;
        }

        /* Radio Group */
        .input-group-custom .mt-3 {
            display: flex;
            gap: 20px;
            align-items: center;
            padding: 10px 0 4px;
            margin-top: 0 !important;
        }

            .input-group-custom .mt-3 input[type="radio"] {
                accent-color: #28a745;
                width: 15px;
                height: 15px;
                cursor: pointer;
                margin: 0;
            }

            .input-group-custom .mt-3 label,
            .input-group-custom .mt-3 {
                font-size: 14px;
                color: #333;
                cursor: pointer;
            }

        /* Textarea */
        textarea.form-control-custom {
            resize: vertical;
            min-height: 80px;
        }

        /* Geo row */
        .input-group-custom.d-flex {
            gap: 8px;
        }

            .input-group-custom.d-flex .form-control-custom {
                flex: 1;
            }

        /* Active Checkbox */
        .mt-2 input[type="checkbox"] {
            accent-color: #28a745;
            width: 15px;
            height: 15px;
            cursor: pointer;
            margin-right: 6px;
            vertical-align: middle;
        }

        .mt-2 {
            font-size: 14px;
            color: #333;
            padding: 6px 0;
        }

        /* ── Error Messages ── */
        .error-msg {
            display: none;
            font-size: 11.5px;
            color: #dc3545;
            margin-top: 2px;
            margin-left: 4px;
            font-weight: 500;
        }

            .error-msg.show {
                display: block;
            }

        /* ── Border States ── */
        .form-control-custom.is-error {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.12) !important;
        }

        .form-control-custom.is-valid {
            border-color: #28a745 !important;
            box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.12) !important;
        }

        /* ── Star required ── */
        .star {
            color: #dc3545;
            font-weight: bold;
        }

        /* ── Buttons ── */
        #btnSave {
            background: #28a745;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: white;
        }

            #btnSave:hover {
                background: #218838;
            }

        #btnClear {
            background: #dc3545;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: white;
        }

            #btnClear:hover {
                background: #c82333;
            }

        #btnClose {
            background: #ffc107;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: #333;
        }

            #btnClose:hover {
                background: #e0a800;
            }

        /* Column dividers */
        .modal-body .row > .col-md-4:not(:last-child) {
            border-right: 1px dashed #e0e0e0;
        }

        /* Section label for radio */
        .input-group-custom > .labelup {
            z-index: 1;
        }

/*Status Badge */
        .dg-status-badge {
            display: inline-flex;
            align-items: center;
            font-size: 13px; /* medium text size */
            padding: 3px 8px; /* slightly more breathing room */
            border-radius: 12px; /* pill shape */
            line-height: 1.4; /* keeps row height consistent */
            white-space: nowrap; /* prevents wrapping in table cells */
        }

        .dg-status-circle {
            width: 9px; /* medium circle */
            height: 9px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .dg-status-active {
            background-color: #eaf9ea;
            color: #2e7d32;
        }

            .dg-status-active .dg-status-circle {
                background-color: #2e7d32;
            }

        .dg-status-inactive {
            background-color: #fdeaea;
            color: #c62828;
        }

            .dg-status-inactive .dg-status-circle {
                background-color: #c62828;
            }

    </style>

</head>

<body>
    <div class="Main-Container">
        <div class="grid-container">
            <!-- Top Bar -->
            <!--<div class="top-bar">
                <div class="top-bar-left">
                    <div class="breadcrumb-row">
                        <span class="breadcrumb-home">🏠 Home</span>
                        <span class="breadcrumb-arrow"> > </span>
                        <span class="breadcrumb-current">Master | Users List</span>
