        </div>

    </div>

    <div class="modal fade" id="addUserModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header">
                    <h5 class="modal-title">Add User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body">
                    <input type="hidden" id="hdnCustomerID" value="0">

                    <div class="row g-3">

                        <!-- 🔹 COLUMN 1 -->
                        <div class="col-md-6">

                            <div class="input-group-custom">
                                <i class="fa-solid fa-id-card"></i>
                                <input type="text" id="txtUserID" class="form-control-custom" placeholder="User ID">
                                <label class="labelup">User ID <span class="star">*</span></label>
                            </div>
                            <div id="err_UserID" class="error-msg">User ID is required</div>

                            <div class="input-group-custom">
                                <i class="fa-solid fa-lock"></i>
                                <input type="password" id="Signuppassword" class="form-control-custom" placeholder="Enter Password">
                                <label class="labelup">Password <span class="star">*</span></label>
                            </div>
                            <div id="err_Password" class="error-msg">Password is required</div>

                            <div class="input-group-custom">
                                <i class="fa-solid fa-phone"></i>
                                <input type="text" id="SignupMobNo" class="form-control-custom" placeholder="Mobile" maxlength="10">
                                <label class="labelup">Mobile No<span class="star">*</span></label>
                            </div>
                            <div id="err_SignupMobNo" class="error-msg">Enter 10 digit number</div>


                            <!-- File -->
                            <div class="input-group-custom">
                                <input type="file" id="txtFile" class="form-control-custom"
                                       multiple onchange="previewUserSelectedFiles(this)">
                                <label class="labelup">Attachments</label>
                            </div>

                            <!-- Attachment Grid -->
                            <div class="Table-Container" style="margin-top:10px;">
                                <div id="grid-UserAttachment-lists"></div>
                            </div>

                        </div>

                        <!-- 🔹 COLUMN 2 -->
                        <div class="col-md-6">

                            <div class="input-group-custom">
                                <i class="fa-solid fa-user"></i>
                                <input type="text" id="txtUserName" class="form-control-custom" placeholder="User Name">
                                <label class="labelup">User Name <span class="star">*</span></label>
                            </div>
                            <div id="err_UserName" class="error-msg">User Name is required</div>

                            <div class="input-col">
                                <div class="input-group-custom">
                                    <i class="fa-solid fa-check-double"></i>
                                    <input type="password" id="SignupConfirmpassword" class="form-control-custom" placeholder="Confirm">
                                    <label class="labelup">Confirm Password<span class="star">*</span></label>
                                </div>
                                <div id="err_SignupConfirmpassword" class="error-msg">Passwords do not match</div>
                            </div>

                            <div class="input-group-custom mt-4">
                                <i class="fa-solid fa-envelope"></i>
                                <input type="email" id="forgotEmail" class="form-control-custom" placeholder="Email Address">
                                <label class="labelup">Email Address<span class="star">*</span></label>
                            </div>
                            <div id="err_forgotEmail" class="error-msg">Valid email is required</div>

                            <div class="input-group-custom">
                                <input type="text" id="txtEmpNo" class="form-control-custom" placeholder="Employee No">
                                <label class="labelup">Employee No</label>
                            </div>
                            <div id="err_EmpNo" class="error-msg">Version is required</div>

                            <div class="mt-2">
                                <input type="checkbox" id="chkActive"> Active
                            </div>

                        </div>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" id="btnClear">
                        <span class="glyphicon glyphicon-refresh"> Clear</span>
                    </button>

                    <button type="button" onclick="return save()" class="btn btn-success" id="btnSave">
                        <span class="glyphicon glyphicon-saved"> Save</span>
                    </button>

                    <button type="button" class="btn btn-warning" id="btnClose">
                        <i class="bi bi-x-circle"></i> Close
                    </button>
                </div>

            </div>
        </div>
