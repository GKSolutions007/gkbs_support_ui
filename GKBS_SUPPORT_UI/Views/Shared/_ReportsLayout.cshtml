@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GKBS Reports</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
    <link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />
    <script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="~/Content/Snackbar.css" rel="stylesheet" />
    <script src="~/Scripts/Validation.js"></script>
    <script src="~/GKBS_Grid/js/gridui.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* ── NAVBAR ── */
        .top-navbar {
            background-color: #008080;
            height: 55px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .company-name {
            color: white;
            font-size: 15px;
            font-weight: 600;
        }

        .navbar-center {
            flex: 1;
            max-width: 480px;
            margin: 0 30px;
        }

        .search-wrapper {
            position: relative;
        }

            .search-wrapper i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255,255,255,0.7);
                font-size: 13px;
            }

        .search-box {
            width: 100%;
            padding: 8px 18px 8px 38px;
            border-radius: 25px;
            border: none;
            background: rgba(255,255,255,0.18);
            color: white;
            font-size: 13px;
            outline: none;
        }

            .search-box::placeholder {
                color: rgba(255,255,255,0.7);
            }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            font-size: 14px;
            font-weight: 500;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #005f5f;
            border: 2px solid rgba(255,255,255,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: white;
            cursor: pointer;
        }

        /* ── LAYOUT ── */
        .main-layout {
            display: flex;
            margin-top: 55px;
            height: calc(100vh - 55px);
        }

        /* ── REPORTS SIDEBAR ── */
        .sidebar {
            width: 240px;
            background: #fff;
            border-right: 1px solid #e0e0e0;
            display: flex;
            flex-direction: column;
            padding: 15px 0;
            flex-shrink: 0;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 15px 15px 15px;
            border-bottom: 1px solid #eee;
            margin-bottom: 10px;
        }

        .sidebar-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 15px;
            color: #333;
        }

            .sidebar-title i {
                color: #008080;
            }

        .close-btn {
            background: none;
            border: none;
            font-size: 18px;
            color: #888;
            cursor: pointer;
            padding: 2px 6px;
            border-radius: 4px;
            transition: background 0.2s;
        }

            .close-btn:hover {
                background: #f0f0f0;
                color: #333;
            }

        .report-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: #555;
            text-decoration: none;
            font-size: 13px;
            border-radius: 6px;
            margin: 2px 8px;
            transition: background 0.2s, color 0.2s;
        }

            .report-link:hover {
                background: #e8f5f5;
                color: #008080;
            }

            .report-link.active {
                background: #e8f5f5;
                color: #008080;
                font-weight: 600;
                border-left: 3px solid #008080;
            }

            .report-link i {
                font-size: 13px;
                width: 16px;
                color: #008080;
            }

        .content-area {
            flex: 1;
            overflow-y: auto;
            padding: 25px;
        }
        .sidebar {
            width: 50px; /* collapsed by default */
            background: #fff;
            border-right: 1px solid #e0e0e0;
            display: flex;
            flex-direction: column;
            padding-top: 10px;
            flex-shrink: 0;
            transition: width 0.3s ease;
            overflow: hidden;
        }

            .sidebar.open {
                width: 220px; /* expanded when open */
            }

        .hamburger-btn {
            background: none;
            border: none;
            font-size: 20px;
            color: #555;
            cursor: pointer;
            padding: 10px 15px;
            display: block;
            width: 100%;
            text-align: right;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .menu-container {
            padding-top: 10px;
            width: 220px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        .sidebar.open .menu-container {
            opacity: 1;
            visibility: visible;
        }

        /* report links inside sidebar */
        .report-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 18px;
            color: #555;
            text-decoration: none;
            font-size: 13px;
            margin: 2px 8px;
            border-radius: 6px;
            transition: background 0.2s, color 0.2s;
            white-space: nowrap;
        }

            .report-link i {
                font-size: 12px;
                color: #008080;
                width: 15px;
            }

            .report-link:hover {
                background: #e8f5f5;
                color: #008080;
            }

            .report-link.active {
                background: #e8f5f5;
                color: #008080;
                font-weight: 600;
                border-left: 3px solid #008080;
                padding-left: 15px;
            }
    </style>
</head>
<body>
    <div class="toastBox"></div>

    <nav class="top-navbar">
        <a href="@Url.Action("Index", "Home")" style="text-decoration:none; display:flex;">
            <div class="navbar-left" style="cursor:pointer;">
                <img src="~/Content/Images/Logo.png" alt="Logo" style="height:28px;" onerror="this.style.display='none'" />
                <span class="company-name">GK BUSINESS &amp; SOLUTIONS</span>
            </div>
        </a>
        <div class="navbar-center">
            <div class="search-wrapper">
                <i class="fa fa-search"></i>
                <input type="text" class="search-box" placeholder="Looking for something?" />
            </div>
        </div>
        <div class="navbar-right">
            <span>Hello, <strong id="lblUserName">User</strong></span>
            <div class="user-avatar" id="avatarIcon" onclick="toggleProfileMenu()">U</div>
            <div id="profileDropdown" style="display:none; position:absolute; top:52px; right:15px; background:white; border-radius:10px; min-width:200px; box-shadow:0 4px 20px rgba(0,0,0,0.15); z-index:9999; overflow:hidden; border:1px solid #eee;">
                <div style="padding:14px 16px; border-bottom:1px solid #f0f0f0;">
                    <div style="font-weight:700; color:#333;" id="dropUserName">User</div>
                    <div style="font-size:11px; color:#999;">Logged In</div>
                </div>
                <div onclick="Logout()" style="padding:12px 16px; cursor:pointer; color:#e53935; font-size:13px; display:flex; align-items:center; gap:10px; border-top:1px solid #f0f0f0;">
                    <i class="fa fa-sign-out-alt" style="color:#e53935;"></i> Logout
                </div>
            </div>
        </div>
    </nav>

    <div class="main-layout">
        <!-- REPORTS SIDEBAR -->
        <div class="sidebar" id="sidebar">
            <span class="hamburger-btn" onclick="toggleSidebar()" title="Menu">
                <i class="fa fa-bars"></i>
            </span>

            <div class="menu-container">
                <!-- Header title inside the open sidebar -->
                <div style="padding: 5px 15px 12px 15px; border-bottom: 1px solid #eee; margin-bottom: 8px;">
                    <div style="display:flex; align-items:center; gap:8px; font-weight:700; font-size:14px; color:#333;">
                        <i class="fa fa-folder-open" style="color:#008080;"></i>
                        <span>Master Reports</span>
                    </div>
                </div>

                <a href="@Url.Action("Index", "Customer")"
                   class="report-link @(ViewBag.ActiveReport == "Customer" ? "active" : "")">
                    <i class="fa fa-users"></i> Customer
                </a>
                <a href="@Url.Action("Index", "Users")"
                   class="report-link @(ViewBag.ActiveReport == "Users" ? "active" : "")">
                    <i class="fa fa-user"></i> Users
                </a>
                <a href="@Url.Action("Index", "DailyActivity")"
                   class="report-link @(ViewBag.ActiveReport == "DailyActivity" ? "active" : "")">
                    <i class="fa fa-calendar-check"></i> Daily Activity
                </a>
                <a href="@Url.Action("Index", "ToDoList")"
                   class="report-link @(ViewBag.ActiveReport == "ToDoList" ? "active" : "")">
                    <i class="fa fa-list-check"></i> To Do List
                </a>
                <a href="@Url.Action("Index", "SampleTable")"
                   class="report-link @(ViewBag.ActiveReport == "SampleTable" ? "active" : "")">
                    <i class="fa fa-table"></i> Sample Table
                </a>
            </div>
        </div>

        <div class="content-area">
            @RenderBody()
        </div>
    </div>

    <script>
        $(document).ready(function () {
            var uid = sessionStorage.getItem("userID");
            var uname = sessionStorage.getItem("userName") || "User";
            $("#lblUserName, #dropUserName").text(uname);
            $("#avatarIcon").text(uname.charAt(0).toUpperCase());
            if (!uid) { window.location.href = '/Login/Index'; }
        });

        function toggleProfileMenu() {
            var dd = document.getElementById('profileDropdown');
            dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
        }

        function toggleSidebar() {
            const sidebar = $('#sidebar');
            const icon = $('.hamburger-btn i');

            sidebar.toggleClass('open');

            if (sidebar.hasClass('open')) {
                icon.attr('class', 'fa fa-times');  // shows X when open
            } else {
                icon.attr('class', 'fa fa-bars');   // shows ☰ when closed
            }
        }

        document.addEventListener('click', function (e) {
            var avatar = document.getElementById('avatarIcon');
            var dd = document.getElementById('profileDropdown');
            if (avatar && dd && !avatar.contains(e.target) && !dd.contains(e.target)) {
                dd.style.display = 'none';
            }
        });

        function goBack() {
            window.location.href = '@Url.Action("Index", "Home")';
        }

        function Logout() {
            sessionStorage.clear();
            window.location.href = '@Url.Action("Index", "Login")';
        }
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>