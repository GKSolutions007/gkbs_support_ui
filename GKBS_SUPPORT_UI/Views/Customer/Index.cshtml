@{
    ViewBag.Title = "Customer";
    Layout = "~/Views/Shared/_LayoutNav1.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Master</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
    <link href="~/GKBS_GRID_2.0/css/gridui.css" rel="stylesheet" />
    <script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>

    <link href="~/Content/Snackbar.css" rel="stylesheet" />
    <script src="~/Scripts/Validation.js"></script>
    <script src="~/GKBS_GRID_2.0/js/gridui.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src='https://maps.googleapis.com/maps/api/js?key=AIzaSyBDhzKQV1BgtvQdvhFwbAjUxUKp4iPL9Is'></script>
    <style>
        .top-bar {
            display: flex;
            justify-content: space-between; /* left and right */
            align-items: center;
            padding: 10px 20px;
            margin-bottom: 15px;
        }

        .breadcrumb-row {
            font-size: 13px;
            color: #888;
            margin-bottom: 5px;
        }

        .breadcrumb-home {
            color: #1a73e8;
        }

        .top-bar-left h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
        }
        #grid-Contact-lists .dg-search-input {
            display: none !important;
        }

        #grid-Attachment-lists .dg-search-input {
            display: none !important;
        }
        .top-bar-right {
            display: flex;
            gap: 10px;
        }

        .modal-xl {
            max-width: 92vw !important;
            width: 92vw !important;
        }

        .btn-print {
            background: white;
            border: 1px solid #ccc;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-add {
            background: #1a73e8;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-print:hover {
            background: #f0f0f0;
        }

        .btn-add:hover {
            background: #1558b0;
        }

        /* Validation Colors */
        .is-invalid {
            border-color: var(--error-red) !important;
            background-color: #fff8f8;
        }

            .is-invalid + .labelup {
                color: var(--error-red) !important;
            }
        /* ============================================================
        CUSTOMER MODAL - COMPLETE CSS
        ============================================================ */

        /* Modal Size */
        .modal-xl {
            max-width: 1100px;
        }

        .modal-content {
            border-radius: 12px;
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        }

        /* Header */
        .modal-header {
            background: linear-gradient(135deg, #1a6e3c, #28a745);
            color: white;
            border-radius: 12px 12px 0 0;
            padding: 16px 24px;
        }

        .modal-title {
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .modal-header .btn-close {
            filter: invert(1);
        }

        /* Footer */
        .modal-footer {
            background: #f8f9fa;
            border-top: 1px solid #e0e0e0;
            border-radius: 0 0 12px 12px;
            padding: 12px 24px;
            gap: 10px;
        }

        /* ── Input Group ── */
        .input-group-custom {
            position: relative;
            margin-bottom: 6px;
            margin-top: 14px;
        }

        .form-control-custom {
            width: 100%;
            padding: 10px 12px 10px 36px;
            font-size: 14px;
            border: 1.5px solid #ced4da;
            border-radius: 8px;
            background: #fff;
            color: #333;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            font-family: inherit;
        }

            .form-control-custom:focus {
                border-color: #28a745;
                box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.15);
            }

        /* input without icon (dates, file, textarea) */
        input[type="date"].form-control-custom,
        input[type="file"].form-control-custom,
        textarea.form-control-custom {
            padding-left: 12px;
        }

        /* Floating Label */
        .labelup {
            position: absolute;
            top: -10px;
            left: 10px;
            font-size: 11px;
            font-weight: 600;
            color: #555;
            background: #fff;
            padding: 0 5px;
            pointer-events: none;
            letter-spacing: 0.3px;
        }

        /* Icon inside input */
        .input-group-custom > i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #888;
            font-size: 13px;
            z-index: 1;
        }

        /* Radio Group */
        .input-group-custom .mt-3 {
            display: flex;
            gap: 20px;
            align-items: center;
            padding: 10px 0 4px;
            margin-top: 0 !important;
        }

            .input-group-custom .mt-3 input[type="radio"] {
                accent-color: #28a745;
                width: 15px;
                height: 15px;
                cursor: pointer;
                margin: 0;
            }

            .input-group-custom .mt-3 label,
            .input-group-custom .mt-3 {
                font-size: 14px;
                color: #333;
                cursor: pointer;
            }

        /* Textarea */
        textarea.form-control-custom {
            resize: vertical;
            min-height: 80px;
        }

        /* Geo row */
        .input-group-custom.d-flex {
            gap: 8px;
        }

            .input-group-custom.d-flex .form-control-custom {
                flex: 1;
            }

        /* Active Checkbox */
        .mt-2 input[type="checkbox"] {
            accent-color: #28a745;
            width: 15px;
            height: 15px;
            cursor: pointer;
            margin-right: 6px;
            vertical-align: middle;
        }

        .mt-2 {
            font-size: 14px;
            color: #333;
            padding: 6px 0;
        }

        /* ── Error Messages ── */
        .error-msg {
            display: none;
            font-size: 11.5px;
            color: #dc3545;
            margin-top: 2px;
            margin-left: 4px;
            font-weight: 500;
        }

            .error-msg.show {
                display: block;
            }

        /* ── Border States ── */
        .form-control-custom.is-error {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.12) !important;
        }

        .form-control-custom.is-valid {
            border-color: #28a745 !important;
            box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.12) !important;
        }

        /* ── Star required ── */
        .star {
            color: #dc3545;
            font-weight: bold;
        }

        /* ── Buttons ── */
        #btnSave {
            background: #28a745;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: white;
        }

            #btnSave:hover {
                background: #218838;
            }

        #btnClear {
            background: #dc3545;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: white;
        }

            #btnClear:hover {
                background: #c82333;
            }

        #btnClose {
            background: #ffc107;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: #333;
        }

            #btnClose:hover {
                background: #e0a800;
            }

        /* Column dividers */
        .modal-body .row > .col-md-4:not(:last-child) {
            border-right: 1px dashed #e0e0e0;
        }

        /* Section label for radio */
        .input-group-custom > .labelup {
            z-index: 1;
        }
        /*Status Badge */
        .dg-status-badge {
            display: inline-flex;
            align-items: center;
            font-size: 13px; /* medium text size */
            padding: 3px 8px; /* slightly more breathing room */
            border-radius: 12px; /* pill shape */
            line-height: 1.4; /* keeps row height consistent */
            white-space: nowrap; /* prevents wrapping in table cells */
        }

        .dg-status-circle {
            width: 9px; /* medium circle */
            height: 9px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .dg-status-active {
            background-color: #eaf9ea;
            color: #2e7d32;
        }

            .dg-status-active .dg-status-circle {
                background-color: #2e7d32;
            }

        .dg-status-inactive {
            background-color: #fdeaea;
            color: #c62828;
        }

            .dg-status-inactive .dg-status-circle {
                background-color: #c62828;
            }
    </style>

</head>
<body>

    <div class="Main-Container">
        <div class="grid-container">
            <!-- Top Bar -->
            @*<div class="top-bar">
                <div class="top-bar-left">
                    <div class="breadcrumb-row">
                        <span class="breadcrumb-home">🏠 Home</span>
                        <span class="breadcrumb-arrow"> > </span>
                        <span class="breadcrumb-current">Master | Customer Details</span>
                    </div>
                    <h2>Customer Details List</h2>
                </div>
                <div class="top-bar-right">
                    <button class="btn-print">🖨️ Print</button>
                    <button class="btn-add" id="btnAddCustomer">+ Add</button>
                </div>
            </div>*@

            <div class="Table-Container">
                <div id="grid-Customer-Detail-lists"></div>
            </div>

        </div>

    </div>


    <div class="modal fade" id="addCustomerModal" tabindex="-1"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header">
                    <h5 class="modal-title">Add Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body">
                    <input type="hidden" id="hdnCustomerID" value="0">

                    <div class="row g-3">

                        <!-- 🔹 COLUMN 1 -->
                        <div class="col-md-3">

                            <div class="input-group-custom">
                                <i class="fa-solid fa-id-card"></i>
                                <input type="text" id="txtCustomerCode" class="form-control-custom" placeholder="Customer Code">
                                <label class="labelup">Customer Code <span class="star">*</span></label>
                            </div>
                            <div id="err_CustCode" class="error-msg">Customer Code is required</div>

                            <div class="input-group-custom">
                                <i class="fa-solid fa-user"></i>
                                <input type="text" id="txtCustomerName" class="form-control-custom" placeholder="Customer Name">
                                <label class="labelup">Customer Name <span class="star">*</span></label>
                            </div>
                            <div id="err_CustName" class="error-msg">Customer Name is required</div>

                            <div class="input-group-custom">
                                <select id="txtParentComp" class="form-control-custom">
                                    <option value="" selected disabled hidden>Select Parent Company</option>
                                </select>
                                <label class="labelup">Parent Comp Code</label>
                            </div>
                            <div id="err_CompCode" class="error-msg">Parent Comp Code is required</div>
                            <div class="input-group-custom">
                                <i class="fa-solid fa-file"></i>
                                <input type="number" id="txtMobNo" class="form-control-custom" maxlength="12" placeholder="Mobile No">
                                <label class="labelup">Mobile No</label>
                            </div>
                            <div id="err_MobNo" class="error-msg">Mobile No is required</div>

                            <div class="input-group-custom">
                                <i class="fa-solid fa-file"></i>
                                <input type="email" id="txtEmailID" class="form-control-custom" placeholder="E-Mail ID">
                                <label class="labelup">E-Mail ID</label>
                            </div>
                            <div id="err_EmailID" class="error-msg">E-Mail ID No is required</div>

                            <div class="input-group-custom">
                                <i class="fa-solid fa-file"></i>
                                <input type="text" id="txtGSTIN" class="form-control-custom" maxlength="15" placeholder="GSTIN">
                                <label class="labelup">GSTIN</label>
                            </div>
                            <div id="err_GSTIN" class="error-msg">GSTIN is required</div>


                        </div>

                        <!-- 🔹 COLUMN 2 -->
                        <div class="col-md-3">
                            <div class="row">
                                <div class="col-6">
                                    <div class="input-group-custom">
                                        <input type="date" id="txtRegisteredDate" class="form-control-custom">
                                        <label class="labelup">Registered Date</label>
                                    </div>
                                    <div id="err_RegDate" class="error-msg">Registered Date is required</div>
                                </div>
                                <div class="col-6">
                                    <div class="input-group-custom">
                                        <input type="date" id="txtAMCDate" class="form-control-custom">
                                        <label class="labelup">AMC Date</label>
                                    </div>
                                    <div id="err_AMCDate" class="error-msg">AMC Date is required</div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <div class="input-group-custom">
                                        <input type="date" id="txtExpDate" class="form-control-custom">
                                        <label class="labelup">Expiry Date</label>
                                    </div>
                                    <div id="err_ExpDate" class="error-msg">Expiry Date is required</div>
                                </div>
                                <div class="col-6">
                                    <div class="input-group-custom">
                                        <input type="date" id="txtWebExpDate" class="form-control-custom">
                                        <label class="labelup">Web Expiry Date</label>
                                    </div>
                                    <div id="err_WebExpDate" class="error-msg">Web Expiry Date is required</div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <div class="input-group-custom">
                                        <input type="text" id="txtClients" class="form-control-custom" placeholder="No of Clients" value="1">
                                        <label class="labelup">No. of Clients</label>
                                    </div>
                                    <div id="err_NoofClients" class="error-msg">No of Clients is required</div>
                                </div>
                                <div class="col-6">
                                    <div class="input-group-custom">
                                        <input type="text" id="txtMobileApp" class="form-control-custom" placeholder="Mobile App" value="0">
                                        <label class="labelup">Mobile App</label>
                                    </div>
                                    <div id="err_MobileApp" class="error-msg">Mobile App is required</div>
                                </div>
                            </div>


                            <div class="input-group-custom">
                                <input type="text" id="txtVersion" class="form-control-custom" placeholder="Version">
                                <label class="labelup">Version</label>
                            </div>
                            <div id="err_Version" class="error-msg">Version is required</div>

                            <!-- Shine Type -->
                            <div class="input-group-custom">
                                <label class="labelup">Shine Type</label>
                                <div class="mt-3">
                                    <input type="radio" name="shineType" value="FA"> FA
                                    <input type="radio" name="shineType" value="Non FA" class="ms-3" checked> Non FA
                                </div>
                            </div>
                            <div id="err_ShineType" class="error-msg">Shine Type is required</div>

                            <!-- User Type -->
                            <div class="input-group-custom">
                                <label class="labelup">User Type</label>
                                <div class="mt-3">
                                    <input type="radio" name="userType" value="Single" checked> Single
                                    <input type="radio" name="userType" value="Multi" class="ms-3"> Multi
                                </div>
                            </div>
                            <div id="err_UserType" class="error-msg">User Type is required</div>



                        </div>

                        <!-- 🔹 COLUMN 3 -->
                        <div class="col-md-3">
                            <!-- Geo -->
                            <div class="input-group-custom d-flex align-items-center">
                                <input type="text" id="txtGeo" class="form-control-custom" placeholder="Geo Location" readonly>
                                <button type="button" id="btnLocation" class="btn btn-sm btn-primary ms-2" onclick="getGeo()">
                                    <span id="spMapMark" class="fa fa-map-marker"
                                          style="font-size:16px"></span><span id="spMapNavigate" class="fa fa-location-arrow" style="font-size:16px"></span>
                                </button>
                                <label class="labelup">Geo Location</label>
                            </div>
                            <div id="err_GeoLocation" class="error-msg">Geo Location is required</div>

                            <div class="input-group-custom">
                                <textarea id="txtAddress" class="form-control-custom" placeholder="Address"></textarea>
                                <label class="labelup">Address</label>
                            </div>
                            <div id="err_Address" class="error-msg">Address is required</div>

                            <div style="margin-top:14px;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                                    <label style="font-size:11px; font-weight:600; color:#555;">Contact Info</label>
                                    <button type="button" id="btnAddContact" onclick="addContactRow()"
                                            style="background:#28a745; color:white; border:none; padding:3px 10px; border-radius:5px; font-size:12px; cursor:pointer;">
                                        ➕ Add Contact
                                    </button>
                                </div>
                                <div id="grid-Contact-lists"></div>
                            </div>
                        </div>

                        <div class="col-md-3">

                            <!-- File -->
                            <div class="input-group-custom">
                                <input type="file" id="txtFile" class="form-control-custom" placeholder="Attachment" multiple
                                       onchange="previewSelectedFiles(this)">
                                <label class="labelup">Attachment</label>
                            </div>

                            <div class="Table-Container" style="margin-top:10px;">
                                <div id="grid-Attachment-lists"></div>
                            </div>

                            <div class="mt-2">
                                <input type="checkbox" id="chkActive"> Active
                            </div>

                        </div>

                        </div>

                    </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" id="btnClear">
                        <span class="glyphicon glyphicon-refresh"> Clear</span>
                    </button>

                    <button type="button" onclick="return save()" class="btn btn-success" id="btnSave">
                        <span class="glyphicon glyphicon-saved"> Save</span>
                    </button>

                    <button type="button" class="btn btn-warning" id="btnClose">
                        <i class="bi bi-x-circle"></i> Close
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script>
        const Aurl = '@Session["APIurl"]';


        var TransMode = 1;
        const addModal = new bootstrap.Modal(document.getElementById('addCustomerModal'));

        $('#btnAddCustomer').click(function () {
            document.getElementById('hdnCustomerID').value = "0";
            const chkActive = document.getElementById('chkActive');
            chkActive.checked = true;
            chkActive.disabled = true;
            addModal.show();
        });

        document.getElementById('btnClose').addEventListener('click', function () {
            ['txtCustomerCode', 'txtCustomerName', 'txtGSTIN', 'txtAMCDate',
                'txtRegisteredDate', 'txtExpDate', 'txtVersion', 'txtClients',
                'txtMobileApp', 'txtParentComp', 'txtAddress', 'txtGeo', 'txtWebExpDate',
                'txtMobNo', 'txtEmailID'
            ].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.disabled = false;
            });

            document.querySelectorAll('input[name="shineType"], input[name="userType"]')
                .forEach(r => r.disabled = false);

            // Show buttons back
            document.getElementById('btnSave').style.display = 'block';
            document.getElementById('btnClear').style.display = 'block';

            addModal.hide();
        });

        const allGridActions = [
            {
                icon: '✏️',
                title: 'Edit',
                displayType: 'single_icon',
                handler: function (row) {
                    fetchAndOpenModal(row.ID, 'edit');
                }
            },
            {
                icon: '👁️',
                title: 'View',
                displayType: 'single_icon',
                handler: function (row) {
                    fetchAndOpenModal(row.ID, 'view');
                }
            },
            {
                icon: '📥',
                title: 'Sync',
                displayType: 'single_icon',
                handler: function (row) {
                    SyncCompany(row.Customercode);
                }
            }
        ];
        var CustomerColumns = [];
        const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
        const menuActions = [];

        var actions = {
            "header": "Action",
            "type": "action",
            "width": 100,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": allGridActions
        };

        GetColumnSettingsData(2, 3, 1);

        loadDashboardGrid();
        loadParentCompOptions();
    //});
        function SyncCompany(strCompanyCode) {
            $.get(Aurl + "customer/synccompany", { CompanyCode: strCompanyCode }, function (rowData) {
                if (rowData.Status == "Success")
                    showSuccessSnackbar(rowData.Message);
                else
                    showErrorSnackbar(rowData.Message);
            });
        }
    function loadDashboardGrid() {
        const Aurl = '@Session["APIurl"]';
    console.log("AURL Value: ",Aurl)

        $.get(Aurl + "customer/GetCustomerList", { userId: 0 }, function (rowData) {
            console.log("Row Data:", rowData);
        //console.log("Row Data for " + apiEndpoint, rowData);
            new GKBSDynamicGrid('#grid-Customer-Detail-lists', CustomerColumns, rowData, {
            enablePagination: true,
            pageSize: 10,
            height: "400px",
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: "",
            CompanyName: "GKBS Support",
                ReportName: "Customers",
                customButtons: [
                    {
                        icon: '➕',
                        text: 'Add New',
                        title: 'Add New',
                        onClick: function () {
                            TransMode = 1;
                            document.querySelector('.modal-title').textContent = 'Add Customer';

                            $("#spMapNavigate").hide();
$("#spMapMark").show();
                            document.getElementById('hdnCustomerID').value = "0";
                            const chkActive = document.getElementById('chkActive');
                            chkActive.checked = true;
                            chkActive.disabled = true;
                            setDefaultDate();
                            loadContactsWithData([]);
                            loadAttachmentsEmpty();
                            document.getElementById('btnAddContact').style.display = 'block';
                            addModal.show();
                        }
                    },
                    {
                        icon: '📥',
                        text: 'Sync All',
                        title: 'Sync All Companies',
                        onClick: function () {
                            SyncCompany("");
                        }
                    }
                ],
                singleIconAction: singleIconAction, // Pass the single View action
                rowActionsMenu: menuActions,
                rowActionsMenu: actions,
                customCellRenderer: (el, col, rowData) => {
                    if (col.field === 'Active') {
                        const val = rowData[col.field];
                        console.log("Active : ", val);
                        if (val === 'True') {
                            el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                        } else if (val === 'False') {
                            el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                        }
                    }
                },
        });
    }).fail(function(xhr) {
        console.error("Row Data FAILED", xhr.status, xhr.responseText);
    });
        }


        const GSTIN_REGEX = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;

        function showErr(errId, msg) {
            const el = document.getElementById(errId);
            if (!el) return;
            if (msg) el.textContent = msg;
            el.style.display = 'block';
        }

        function hideErr(errId) {
            const el = document.getElementById(errId);
            if (el) el.style.display = 'none';
        }

        function setError(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return;
            el.style.border = '1.5px solid #dc3545';
            el.style.boxShadow = '0 0 0 3px rgba(220,53,69,0.15)';
        }

        function setValid(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return;
            el.style.border = '1.5px solid #28a745';
            el.style.boxShadow = '0 0 0 3px rgba(40,167,69,0.12)';
        }

        function clearBorder(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return;
            el.style.border = '1.5px solid #ced4da';
            el.style.boxShadow = 'none';
        }

        function validateRequired(inputId, errId, label) {
            hideErr(errId);
            setValid(inputId);
            const el = document.getElementById(inputId);
            if (!el) return true;
            const val = el.value.trim();
            if (!val) {
                showErr(errId, label + ' is required');
                setError(inputId);
                return false;
            }

            return true;
        }
        function setDefaultDate() {
            let today = new Date().toISOString().split('T')[0];

            document.getElementById("txtAMCDate").value = today;
            document.getElementById("txtRegisteredDate").value = today;
            document.getElementById("txtExpDate").value = today;
            document.getElementById("txtWebExpDate").value = today;

        }
        function formatDateForInput(dateVal) {
            if (!dateVal) return '';

            // Handle new format: 01/Apr/2026
            const months = {
                'Jan': '01', 'Feb': '02', 'Mar': '03', 'Apr': '04',
                'May': '05', 'Jun': '06', 'Jul': '07', 'Aug': '08',
                'Sep': '09', 'Oct': '10', 'Nov': '11', 'Dec': '12'
            };

            const parts = dateVal.split('/');
            if (parts.length === 3) {
                const day = parts[0];
                const month = months[parts[1]];
                const year = parts[2];
                if (day && month && year) {
                    return year + '-' + month + '-' + day;
                }
            }

            return '';
        }

        function validateNumberOnly(inputId, errId, label) {
            const el = document.getElementById(inputId);
            if (!el) return true;
            const val = el.value.trim();

            if (!val) {
                showErr(errId, label + ' is required');
                setError(inputId);
                return false;
            }
            if (!/^\d+$/.test(val)) {
                showErr(errId, label + ' — numbers only, no letters or special characters');
                setError(inputId);
                return false;
            }
            if (parseInt(val) < 0) {
                showErr(errId, label + ' must be a number');
                setError(inputId);
                return false;
            }
            hideErr(errId);
            setValid(inputId);
            return true;
        }
