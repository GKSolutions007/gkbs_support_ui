        function uploadAttachment(customerID) {
    const fileInput = document.getElementById('txtFile');
    if (!fileInput || fileInput.files.length === 0) return; // no files? skip

    // 5MB check
    for (let i = 0; i < fileInput.files.length; i++) {
        if (fileInput.files[i].size > 5 * 1024 * 1024) {
            showErrorSnackbar(`${fileInput.files[i].name} exceeds 5MB limit!`);
            return;
        }
    }

    const formData = new FormData();
    formData.append('CustomerID', customerID);
    formData.append('UID', '@Session["LoginUserID"]');
    for (let i = 0; i < fileInput.files.length; i++) {
        formData.append('files', fileInput.files[i]);
    }

    $.ajax({
        url: Aurl + "Customer/SaveAttachment",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            if (res[0].Status === "Success") {
                showSuccessSnackbar("Files uploaded successfully!");
                loadAttachments(customerID);
            } else {
                showErrorSnackbar(res[0].Message);
            }
        },
        error: function (xhr) {
            showErrorSnackbar("Upload error: " + xhr.responseText);
        }
    });
}

