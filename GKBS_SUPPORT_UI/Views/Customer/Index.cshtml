@{
    ViewBag.Title = "Customer";
    Layout = "~/Views/Shared/_LayoutNav1.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Master</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
    <link href="~/GKBS_GRID_2.0/css/gridui.css" rel="stylesheet" />
    <script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Content/Snackbar.css" rel="stylesheet" />
    <script src="~/Scripts/Validation.js"></script>
    <script src="~/GKBS_GRID_2.0/js/gridui.js"></script>

    <style>
        .top-bar {
            display: flex;
            justify-content: space-between; /* left and right */
            align-items: center;
            padding: 10px 20px;
            margin-bottom: 15px;
        }

        .breadcrumb-row {
            font-size: 13px;
            color: #888;
            margin-bottom: 5px;
        }

        .breadcrumb-home {
            color: #1a73e8;
        }

        .top-bar-left h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
        }

        .top-bar-right {
            display: flex;
            gap: 10px;
        }

        .btn-print {
            background: white;
            border: 1px solid #ccc;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-add {
            background: #1a73e8;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-print:hover {
            background: #f0f0f0;
        }

        .btn-add:hover {
            background: #1558b0;
        }

        /* Validation Colors */
        .is-invalid {
            border-color: var(--error-red) !important;
            background-color: #fff8f8;
        }

            .is-invalid + .labelup {
                color: var(--error-red) !important;
            }
        /* ============================================================
   CUSTOMER MODAL - COMPLETE CSS
   ============================================================ */

        /* Modal Size */
        .modal-xl {
            max-width: 1100px;
        }

        .modal-content {
            border-radius: 12px;
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        }

        /* Header */
        .modal-header {
            background: linear-gradient(135deg, #1a6e3c, #28a745);
            color: white;
            border-radius: 12px 12px 0 0;
            padding: 16px 24px;
        }

        .modal-title {
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .modal-header .btn-close {
            filter: invert(1);
        }

        /* Footer */
        .modal-footer {
            background: #f8f9fa;
            border-top: 1px solid #e0e0e0;
            border-radius: 0 0 12px 12px;
            padding: 12px 24px;
            gap: 10px;
        }

        /* ── Input Group ── */
        .input-group-custom {
            position: relative;
            margin-bottom: 6px;
            margin-top: 14px;
        }

        .form-control-custom {
            width: 100%;
            padding: 10px 12px 10px 36px;
            font-size: 14px;
            border: 1.5px solid #ced4da;
            border-radius: 8px;
            background: #fff;
            color: #333;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            font-family: inherit;
        }

            .form-control-custom:focus {
                border-color: #28a745;
                box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.15);
            }

        /* input without icon (dates, file, textarea) */
        input[type="date"].form-control-custom,
        input[type="file"].form-control-custom,
        textarea.form-control-custom {
            padding-left: 12px;
        }

        /* Floating Label */
        .labelup {
            position: absolute;
            top: -10px;
            left: 10px;
            font-size: 11px;
            font-weight: 600;
            color: #555;
            background: #fff;
            padding: 0 5px;
            pointer-events: none;
            letter-spacing: 0.3px;
        }

        /* Icon inside input */
        .input-group-custom > i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #888;
            font-size: 13px;
            z-index: 1;
        }

        /* Radio Group */
        .input-group-custom .mt-3 {
            display: flex;
            gap: 20px;
            align-items: center;
            padding: 10px 0 4px;
            margin-top: 0 !important;
        }

            .input-group-custom .mt-3 input[type="radio"] {
                accent-color: #28a745;
                width: 15px;
                height: 15px;
                cursor: pointer;
                margin: 0;
            }

            .input-group-custom .mt-3 label,
            .input-group-custom .mt-3 {
                font-size: 14px;
                color: #333;
                cursor: pointer;
            }

        /* Textarea */
        textarea.form-control-custom {
            resize: vertical;
            min-height: 80px;
        }

        /* Geo row */
        .input-group-custom.d-flex {
            gap: 8px;
        }

            .input-group-custom.d-flex .form-control-custom {
                flex: 1;
            }

        /* Active Checkbox */
        .mt-2 input[type="checkbox"] {
            accent-color: #28a745;
            width: 15px;
            height: 15px;
            cursor: pointer;
            margin-right: 6px;
            vertical-align: middle;
        }

        .mt-2 {
            font-size: 14px;
            color: #333;
            padding: 6px 0;
        }

        /* ── Error Messages ── */
        .error-msg {
            display: none;
            font-size: 11.5px;
            color: #dc3545;
            margin-top: 2px;
            margin-left: 4px;
            font-weight: 500;
        }

            .error-msg.show {
                display: block;
            }

        /* ── Border States ── */
        .form-control-custom.is-error {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.12) !important;
        }

        .form-control-custom.is-valid {
            border-color: #28a745 !important;
            box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.12) !important;
        }

        /* ── Star required ── */
        .star {
            color: #dc3545;
            font-weight: bold;
        }

        /* ── Buttons ── */
        #btnSave {
            background: #28a745;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: white;
        }

            #btnSave:hover {
                background: #218838;
            }

        #btnClear {
            background: #dc3545;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: white;
        }

            #btnClear:hover {
                background: #c82333;
            }

        #btnClose {
            background: #ffc107;
            border: none;
            padding: 8px 24px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            color: #333;
        }

            #btnClose:hover {
                background: #e0a800;
            }

        /* Column dividers */
        .modal-body .row > .col-md-4:not(:last-child) {
            border-right: 1px dashed #e0e0e0;
        }

        /* Section label for radio */
        .input-group-custom > .labelup {
            z-index: 1;
        }
        /*Status Badge */
        .dg-status-badge {
            display: inline-flex;
            align-items: center;
            font-size: 13px; /* medium text size */
            padding: 3px 8px; /* slightly more breathing room */
            border-radius: 12px; /* pill shape */
            line-height: 1.4; /* keeps row height consistent */
            white-space: nowrap; /* prevents wrapping in table cells */
        }

        .dg-status-circle {
            width: 9px; /* medium circle */
            height: 9px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .dg-status-active {
            background-color: #eaf9ea;
            color: #2e7d32;
        }

            .dg-status-active .dg-status-circle {
                background-color: #2e7d32;
            }

        .dg-status-inactive {
            background-color: #fdeaea;
            color: #c62828;
        }

            .dg-status-inactive .dg-status-circle {
                background-color: #c62828;
            }
    </style>

</head>
<body>

    <div class="Main-Container">
        <div class="grid-container">
            <!-- Top Bar -->
            @*<div class="top-bar">
                <div class="top-bar-left">
                    <div class="breadcrumb-row">
                        <span class="breadcrumb-home">🏠 Home</span>
                        <span class="breadcrumb-arrow"> > </span>
                        <span class="breadcrumb-current">Master | Customer Details</span>
                    </div>
                    <h2>Customer Details List</h2>
                </div>
                <div class="top-bar-right">
                    <button class="btn-print">🖨️ Print</button>
                    <button class="btn-add" id="btnAddCustomer">+ Add</button>
                </div>
            </div>*@

            <div class="Table-Container">
                <div id="grid-Customer-Detail-lists"></div>
            </div>

        </div>

    </div>


    <div class="modal fade" id="addCustomerModal" tabindex="-1"  data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header">
                    <h5 class="modal-title">Add Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body">
                    <input type="hidden" id="hdnCustomerID" value="0">

                    <div class="row g-3">

                        <!-- 🔹 COLUMN 1 -->
                        <div class="col-md-4">

                            <div class="input-group-custom">
                                <i class="fa-solid fa-id-card"></i>
                                <input type="text" id="txtCustomerCode" class="form-control-custom" placeholder="Customer Code">
                                <label class="labelup">Customer Code <span class="star">*</span></label>
                            </div>
                            <div id="err_CustCode" class="error-msg">Customer Code is required</div>

                            <div class="input-group-custom">
                                <i class="fa-solid fa-user"></i>
                                <input type="text" id="txtCustomerName" class="form-control-custom" placeholder="Customer Name">
                                <label class="labelup">Customer Name <span class="star">*</span></label>
                            </div>
                            <div id="err_CustName" class="error-msg">Customer Name is required</div>

                            <div class="input-group-custom">
                                <i class="fa-solid fa-file"></i>
                                <input type="text" id="txtGSTIN" class="form-control-custom" placeholder="GSTIN">
                                <label class="labelup">GSTIN</label>
                            </div>
                            <div id="err_GSTIN" class="error-msg">GSTIN is required</div>

                            <div class="input-group-custom">
                                <input type="date" id="txtAMCDate" class="form-control-custom">
                                <label class="labelup">AMC Date</label>
                            </div>
                            <div id="err_AMCDate" class="error-msg">AMC Date is required</div>

                            <div class="input-group-custom">
                                <input type="date" id="txtRegisteredDate" class="form-control-custom">
                                <label class="labelup">Registered Date</label>
                            </div>
                            <div id="err_RegDate" class="error-msg">Registered Date is required</div>

                        </div>

                        <!-- 🔹 COLUMN 2 -->
                        <div class="col-md-4">

                            <div class="input-group-custom">
                                <input type="date" id="txtExpDate" class="form-control-custom">
                                <label class="labelup">Expiry Date</label>
                            </div>
                            <div id="err_ExpDate" class="error-msg">Expiry Date is required</div>

                            <div class="input-group-custom">
                                <input type="text" id="txtVersion" class="form-control-custom" placeholder="Version">
                                <label class="labelup">Version</label>
                            </div>
                            <div id="err_Version" class="error-msg">Version is required</div>

                            <!-- Shine Type -->
                            <div class="input-group-custom">
                                <label class="labelup">Shine Type</label>
                                <div class="mt-3">
                                    <input type="radio" name="shineType" value="FA"> FA
                                    <input type="radio" name="shineType" value="Non FA" class="ms-3"> Non FA
                                </div>
                            </div>
                            <div id="err_ShineType" class="error-msg">Shine Type is required</div>

                            <!-- User Type -->
                            <div class="input-group-custom">
                                <label class="labelup">User Type</label>
                                <div class="mt-3">
                                    <input type="radio" name="userType" value="Single"> Single
                                    <input type="radio" name="userType" value="Multi" class="ms-3"> Multi
                                </div>
                            </div>
                            <div id="err_UserType" class="error-msg">User Type is required</div>

                            <!-- File -->
                            <div class="input-group-custom">
                                <input type="file" id="txtFile" class="form-control-custom" placeholder="Attachment">
                                <label class="labelup">Attachment</label>
                            </div>

                        </div>

                        <!-- 🔹 COLUMN 3 -->
                        <div class="col-md-4">

                            <div class="input-group-custom">
                                <input type="text" id="txtClients" class="form-control-custom" placeholder="No of Clients">
                                <label class="labelup">No. of Clients</label>
                            </div>
                            <div id="err_NoofClients" class="error-msg">No of Clients is required</div>

                            <div class="input-group-custom">
                                <input type="text" id="txtMobileApp" class="form-control-custom" placeholder="Mobile App">
                                <label class="labelup">Mobile App</label>
                            </div>
                            <div id="err_MobileApp" class="error-msg">Mobile App is required</div>

                            <div class="input-group-custom">
                                <select id="txtParentComp" class="form-control-custom">
                                    <option value="" selected disabled hidden>Select Parent Company</option>
                                </select>
                                <label class="labelup">Parent Comp Code</label>
                            </div>
                            <div id="err_CompCode" class="error-msg">Parent Comp Code is required</div>

                            <!-- Geo -->
                            <div class="input-group-custom d-flex align-items-center">
                                <input type="text" id="txtGeo" class="form-control-custom" placeholder="Geo Location" readonly>
                                <button type="button" class="btn btn-sm btn-primary ms-2" onclick="getGeo()">📍</button>
                                <label class="labelup">Geo Location</label>
                            </div>
                            <div id="err_GeoLocation" class="error-msg">Geo Location is required</div>

                            <div class="input-group-custom">
                                <textarea id="txtAddress" class="form-control-custom" placeholder="Address"></textarea>
                                <label class="labelup">Address</label>
                            </div>
                            <div id="err_Address" class="error-msg">Address is required</div>

                            <div class="mt-2">
                                <input type="checkbox" id="chkActive"> Active
                            </div>

                        </div>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" id="btnClear">
                        <span class="glyphicon glyphicon-refresh"> Clear</span>
                    </button>

                    <button type="button" onclick="return save()" class="btn btn-success" id="btnSave">
                        <span class="glyphicon glyphicon-saved"> Save</span>
                    </button>

                    <button type="button" class="btn btn-warning" id="btnClose">
                        <i class="bi bi-x-circle"></i> Close
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script>
        const Aurl = '@Session["APIurl"]';



        const addModal = new bootstrap.Modal(document.getElementById('addCustomerModal'));

        $('#btnAddCustomer').click(function () {
            document.getElementById('hdnCustomerID').value = "0";
            const chkActive = document.getElementById('chkActive');
            chkActive.checked = true;
            chkActive.disabled = true;
            addModal.show();
        });

        document.getElementById('btnClose').addEventListener('click', function () {
            ['txtCustomerCode', 'txtCustomerName', 'txtGSTIN', 'txtAMCDate',
                'txtRegisteredDate', 'txtExpDate', 'txtVersion', 'txtClients',
                'txtMobileApp', 'txtParentComp', 'txtAddress', 'txtGeo'
            ].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.disabled = false;
            });

            document.querySelectorAll('input[name="shineType"], input[name="userType"]')
                .forEach(r => r.disabled = false);

            // Show buttons back
            document.getElementById('btnSave').style.display = 'block';
            document.getElementById('btnClear').style.display = 'block';

            addModal.hide();
        });

        const allGridActions = [
            {
                icon: '✏️',
                title: 'Edit',
                displayType: 'single_icon',
                handler: function (row) {
                    openEditModal(row);
                }
            },
            {
                icon: '👁️',
                title: 'View',
                displayType: 'single_icon',
                handler: function (row) {
                    openViewModal(row);
                }
            }
        ];
        var CustomerColumns = [];
        const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
        const menuActions = [];

        var actions = {
            "header": "Action",
            "type": "action",
            "width": 80,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": allGridActions
        };

        GetColumnSettingsData(2, 3, 1);

        loadDashboardGrid();
        loadParentCompOptions();
    //});

    function loadDashboardGrid() {
        const Aurl = '@Session["APIurl"]';
    console.log("AURL Value: ",Aurl)
    const userId = sessionStorage.getItem("userID");

        $.get(Aurl + "customer/GetCustomerList", { userId: userId }, function (rowData) {
            console.log("Row Data:", rowData);
        //console.log("Row Data for " + apiEndpoint, rowData);
            new GKBSDynamicGrid('#grid-Customer-Detail-lists', CustomerColumns, rowData, {
            enablePagination: true,
            pageSize: 10,
            height: "400px",
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: "",
            CompanyName: "GKBS Support",
                ReportName: "Customers",
                customButtons: [
                    {
                        icon: '➕',
                        text: 'Add New',
                        title: 'ADD',
                        onClick: function () {
                            document.getElementById('hdnCustomerID').value = "0";
                            const chkActive = document.getElementById('chkActive');
                            chkActive.checked = true;
                            chkActive.disabled = true;
                            addModal.show();
                        }
                    }
                ],
                singleIconAction: singleIconAction, // Pass the single View action
                rowActionsMenu: menuActions,   
                rowActionsMenu: actions,
                customCellRenderer: (el, col, rowData) => {
                    if (col.field === 'Active') {
                        const val = rowData[col.field];
                        console.log("Active : ", val);
                        if (val === 'True') {
                            el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                        } else if (val === 'False') {
                            el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                        }
                    }
                },
        });
    }).fail(function(xhr) {
        console.error("Row Data FAILED", xhr.status, xhr.responseText);
    });
        }


        const GSTIN_REGEX = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;

        function showErr(errId, msg) {
            const el = document.getElementById(errId);
            if (!el) return;
            if (msg) el.textContent = msg;
            el.style.display = 'block';
        }

        function hideErr(errId) {
            const el = document.getElementById(errId);
            if (el) el.style.display = 'none';
        }

        function setError(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return;
            el.style.border = '1.5px solid #dc3545';
            el.style.boxShadow = '0 0 0 3px rgba(220,53,69,0.15)';
        }

        function setValid(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return;
            el.style.border = '1.5px solid #28a745';
            el.style.boxShadow = '0 0 0 3px rgba(40,167,69,0.12)';
        }

        function clearBorder(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return;
            el.style.border = '1.5px solid #ced4da';
            el.style.boxShadow = 'none';
        }

        function validateRequired(inputId, errId, label) {
            const el = document.getElementById(inputId);
            if (!el) return true;
            const val = el.value.trim();
            if (!val) {
                showErr(errId, label + ' is required');
                setError(inputId);
                return false;
            }
            hideErr(errId);
            setValid(inputId);
            return true;
        }

        function formatDateForInput(dateVal) {
            if (!dateVal) return '';
            const parts = dateVal.split(' ')[0].split('/');
            if (parts.length === 3) {
                return parts[2] + '-' + parts[1] + '-' + parts[0];
            }

            return '';
        }

        function validateNumberOnly(inputId, errId, label) {
            const el = document.getElementById(inputId);
            if (!el) return true;
            const val = el.value.trim();

            if (!val) {
                showErr(errId, label + ' is required');
                setError(inputId);
                return false;
            }
            if (!/^\d+$/.test(val)) {
                showErr(errId, label + ' — numbers only, no letters or special characters');
                setError(inputId);
                return false;
            }
            if (parseInt(val) <= 0) {
                showErr(errId, label + ' must be greater than 0');
                setError(inputId);
                return false;
            }
            hideErr(errId);
            setValid(inputId);
            return true;
        }


        function validateGSTIN() {
            const el = document.getElementById('txtGSTIN');
            if (!el) return true;
            const val = el.value.trim().toUpperCase();

            if (!val) {
                showErr('err_GSTIN', 'GSTIN is required');
                setError('txtGSTIN');
                return false;
            }
            if (val.length !== 15) {
                showErr('err_GSTIN', 'GSTIN must be exactly 15 characters');
                setError('txtGSTIN');
                return false;
            }
            if (!GSTIN_REGEX.test(val)) {
                showErr('err_GSTIN', 'Invalid GSTIN format — e.g. 22AAAAA0000A1Z5');
                setError('txtGSTIN');
                return false;
            }
            hideErr('err_GSTIN');
            setValid('txtGSTIN');
            return true;
        }

        function validateRadio(name, errId, label) {
            const checked = document.querySelector(`input[name="${name}"]:checked`);
            if (!checked) {
                showErr(errId, label + ' is required');
                return false;
            }
            hideErr(errId);
            return true;
        }


        function getGeo() {
            if (!navigator.geolocation) {
                alert('Geolocation not supported by your browser');
                return;
            }
            navigator.geolocation.getCurrentPosition(
                function (pos) {
                    const val = pos.coords.latitude.toFixed(6) + ', ' + pos.coords.longitude.toFixed(6);
                    document.getElementById('txtGeo').value = val;
                    hideErr('err_GeoLocation');
                    setValid('txtGeo');
                },
                function () {
                    alert('Could not get location. Please allow location access.');
                }
            );
        }

        function loadParentCompOptions() {
            var finalUrl = Aurl + "customer/GetCustomerList";

            $.ajax({
                url: finalUrl,
                type: 'GET',
                data: { userId: 0 },
                dataType: 'json',
                success: function (res) {
                    if (Array.isArray(res)) {
                        let dropdown = $('#txtParentComp');
                        dropdown.empty();
                        dropdown.append('<option value="" selected disabled hidden>Select Parent Company</option>');

                        $.each(res, function (index, cust) {
                            let label = cust.Customercode + " - " + cust.Customername;
                            let value = cust.ID;

                            dropdown.append($('<option></option>').val(value).text(label));
                        });
                    }
                },
                error: function (err) {
                    // If this still fails, check the console to see the "Attempted URL"
                    showErrorSnackbar('❌ Failed URL: ' + finalUrl);
                    showErrorSnackbar('❌ Status: ' + err.status);
                }
            });
        }

        function save() {

            if (!validateAll()) return;

            const userId = sessionStorage.getItem("userID");

            const geoVal = document.getElementById('txtGeo').value.trim();
            let lat = "", lng = "";
            if (geoVal) {
                const parts = geoVal.split(',');
                lat = parts[0].trim();
                lng = parts[1] ? parts[1].trim() : "";
            }


            const shineChecked = document.querySelector('input[name="shineType"]:checked');
            const shineVal = shineChecked ? (shineChecked.value === "FA" ? "1" : "0") : "";


            const userChecked = document.querySelector('input[name="userType"]:checked');
            const userVal = userChecked ? (userChecked.value === "Single" ? "1" : "0") : "";

            const activeVal = document.getElementById('chkActive').checked ? "1" : "0";

            const customerId = document.getElementById('hdnCustomerID')
                ? document.getElementById('hdnCustomerID').value
                : "0";

            const payload = {
                ID: customerId,
                Customercode: document.getElementById('txtCustomerCode').value.trim(),
                Customername: document.getElementById('txtCustomerName').value.trim(),
                GSTIN: document.getElementById('txtGSTIN').value.trim(),
                AmcDate: document.getElementById('txtAMCDate').value,
                RegisteredDate: document.getElementById('txtRegisteredDate').value,
                ExpDate: document.getElementById('txtExpDate').value,
                Version: document.getElementById('txtVersion').value.trim(),
                ShineType: shineVal,
                Usertype: userVal,
                NoofClient: document.getElementById('txtClients').value.trim(),
                MobileApp: document.getElementById('txtMobileApp').value.trim(),
                ParentCompCode: document.getElementById('txtParentComp').value,
                Latitude: lat,
                Longitude: lng,
                Address: document.getElementById('txtAddress').value.trim(),
                Active: activeVal,
                UID: userId,
                ContactInfo: []
            };

            console.log("Saving payload:", payload);

            $.ajax({
                url: Aurl + "Customer/Save",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {
                    console.log("Save response:", res);

                    if (res && res.length > 0 && res[0].Status === "Success") {
                        showSuccessSnackbar(res[0].Message);

                        addModal.hide();
                        document.getElementById('btnClear').click();

                        loadDashboardGrid(1002, 1, '#grid-Customer-Detail-lists', "uspManageCustomerMaster", "", CustomerColumns);
                    } else {
                        showErrorSnackbar((res[0] ? res[0].Message : "Something went wrong"));
                    }
                },
                error: function (xhr) {
                    showErrorSnackbar("Save failed:", xhr.status, xhr.responseText);
                    showErrorSnackbar("Error: " + xhr.responseText);
                }
            });
        }

        function openEditModal(row) {

            document.getElementById('hdnCustomerID').value = row.ID;

            // 2. Fill all fields
            document.getElementById('txtCustomerCode').value = row.Customercode || '';
            document.getElementById('txtCustomerName').value = row.Customername || '';
            document.getElementById('txtGSTIN').value = row.GSTIN || '';
            document.getElementById('txtAMCDate').value = formatDateForInput(row.AmcDate);
            document.getElementById('txtRegisteredDate').value = formatDateForInput(row.RegisteredDate);
            document.getElementById('txtExpDate').value = formatDateForInput(row.ExpDate);
            document.getElementById('txtVersion').value = row.Version || '';
            document.getElementById('txtClients').value = row.NoofClient || '';
            document.getElementById('txtMobileApp').value = row.MobileApp || '';
            document.getElementById('txtParentComp').value = row.ParentCompCode || '';
            document.getElementById('txtAddress').value = row.Address || '';

            // 3. Set Geo
            if (row.Latitude && row.Longitude) {
                document.getElementById('txtGeo').value = row.Latitude + ', ' + row.Longitude;
            }

            // 4. Set ShineType radio (1 = FA, 0 = Non FA)
            document.querySelectorAll('input[name="shineType"]').forEach(r => r.checked = false);
            if (row.ShineType === 'True') {   // 👈 was == '1'
                document.querySelector('input[name="shineType"][value="FA"]').checked = true;
            } else {
                document.querySelector('input[name="shineType"][value="Non FA"]').checked = true;
            }

            // 5. Set UserType radio (1 = Single, 0 = Multi)
            document.querySelectorAll('input[name="userType"]').forEach(r => r.checked = false);
            if (row.Usertype === 'True') {    // 👈 was == '1'  (True = Single)
                document.querySelector('input[name="userType"][value="Single"]').checked = true;
            } else {
                document.querySelector('input[name="userType"][value="Multi"]').checked = true;
            }

            // 6. Active checkbox — enable it in edit mode
            const chkActive = document.getElementById('chkActive');
            chkActive.checked = row.Active === 'True';
            chkActive.disabled = false;  // 👈 editable in edit mode

            // 7. Update modal title
            document.querySelector('.modal-title').textContent = 'Edit Customer';

            // 8. Open modal
            addModal.show();
        }

        function openViewModal(row) {
            // 1. Fill all fields (same as edit)
            document.getElementById('hdnCustomerID').value = row.ID;
            document.getElementById('txtCustomerCode').value = row.Customercode || '';
            document.getElementById('txtCustomerName').value = row.Customername || '';
            document.getElementById('txtGSTIN').value = row.GSTIN || '';
            document.getElementById('txtAMCDate').value = formatDateForInput(row.AmcDate);
            document.getElementById('txtRegisteredDate').value = formatDateForInput(row.RegisteredDate);
            document.getElementById('txtExpDate').value = formatDateForInput(row.ExpDate);
            document.getElementById('txtVersion').value = row.Version || '';
            document.getElementById('txtClients').value = row.NoofClient || '';
            document.getElementById('txtMobileApp').value = row.MobileApp || '';
            document.getElementById('txtParentComp').value = row.ParentCompCode || '';
            document.getElementById('txtAddress').value = row.Address || '';

            if (row.Latitude && row.Longitude) {
                document.getElementById('txtGeo').value = row.Latitude + ', ' + row.Longitude;
            }

            document.querySelectorAll('input[name="shineType"]').forEach(r => r.checked = false);
            if (row.ShineTypeValue === 'FA') {
                document.querySelector('input[name="shineType"][value="FA"]').checked = true;
            } else {
                document.querySelector('input[name="shineType"][value="Non FA"]').checked = true;
            }

            document.querySelectorAll('input[name="userType"]').forEach(r => r.checked = false);
            if (row.UsertypeValue === 'Single User') {
                document.querySelector('input[name="userType"][value="Single"]').checked = true;
            } else {
                document.querySelector('input[name="userType"][value="Multi"]').checked = true;
            }

            const chkActive = document.getElementById('chkActive');
            chkActive.checked = row.Active === 'True';
            chkActive.disabled = true;


            ['txtCustomerCode', 'txtCustomerName', 'txtGSTIN', 'txtAMCDate',
                'txtRegisteredDate', 'txtExpDate', 'txtVersion', 'txtClients',
                'txtMobileApp', 'txtParentComp', 'txtAddress', 'txtGeo'
            ].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.disabled = true;
            });


            document.querySelectorAll('input[name="shineType"], input[name="userType"]')
                .forEach(r => r.disabled = true);


            document.querySelector('.modal-title').textContent = 'View Customer';


            document.getElementById('btnSave').style.display = 'none';
            document.getElementById('btnClear').style.display = 'none';
            document.getElementById('btnClose').style.display = 'block';


            addModal.show();
        }

        function validateAll() {
            let ok = true;

            // Column 1
            if (!validateRequired('txtCustomerCode', 'err_CustCode', 'Customer Code')) ok = false;
            if (!validateRequired('txtCustomerName', 'err_CustName', 'Customer Name')) ok = false;
            if (!validateGSTIN()) ok = false;
            if (!validateRequired('txtAMCDate', 'err_AMCDate', 'AMC Date')) ok = false;
            if (!validateRequired('txtRegisteredDate', 'err_RegDate', 'Registered Date')) ok = false;

            // Column 2
            if (!validateRequired('txtExpDate', 'err_ExpDate', 'Expiry Date')) ok = false;
            if (!validateRequired('txtVersion', 'err_Version', 'Version')) ok = false;
            if (!validateRadio('shineType', 'err_ShineType', 'Shine Type')) ok = false;
            if (!validateRadio('userType', 'err_UserType', 'User Type')) ok = false;

            // Column 3
            if (!validateNumberOnly('txtClients', 'err_NoofClients', 'No. of Clients')) ok = false;
            if (!validateNumberOnly('txtMobileApp', 'err_MobileApp', 'Mobile App')) ok = false;
            if (!validateRequired('txtParentComp', 'err_CompCode', 'Parent Comp Code')) ok = false;
            if (!validateRequired('txtGeo', 'err_GeoLocation', 'Geo Location')) ok = false;
            if (!validateRequired('txtAddress', 'err_Address', 'Address')) ok = false;

            if (!ok) {

                const firstErr = document.querySelector('[id^="err_"]');
                if (firstErr) {
                    const allErrs = Array.from(document.querySelectorAll('[id^="err_"]'))
                        .find(e => e.style.display === 'block');
                    if (allErrs) allErrs.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }

            return ok;
        }


        document.addEventListener('DOMContentLoaded', function () {

            const btnClear = document.getElementById('btnClear');
            if (btnClear) {
                btnClear.addEventListener('click', function () {

                    ['txtCustomerCode', 'txtCustomerName', 'txtGSTIN', 'txtAMCDate',
                        'txtRegisteredDate', 'txtExpDate', 'txtVersion', 'txtClients',
                        'txtMobileApp', 'txtParentComp', 'txtGeo', 'txtAddress'
                    ].forEach(function (id) {
                        const el = document.getElementById(id);
                        if (el) { el.value = ''; clearBorder(id); }
                    });

                    // Clear radios
                    document.querySelectorAll('input[name="shineType"], input[name="userType"]')
                        .forEach(function (r) { r.checked = false; });

                    // Clear file input
                    const fileEl = document.getElementById('txtFile');
                    if (fileEl) fileEl.value = '';

                    // Uncheck Active
                    const chk = document.getElementById('chkActive');
                    const isAddMode = document.getElementById('hdnCustomerID').value === "0";
                    if (chk) {
                        if (isAddMode) {
                            chk.checked = true;
                            chk.disabled = true;
                        } else {
                            chk.checked = false;
                            chk.disabled = false;
                        }
                    }

                    // Hide all error messages
                    document.querySelectorAll('[id^="err_"]').forEach(function (el) {
                        el.style.display = 'none';
                    });
                });
            }


            const modal = document.getElementById('addCustomerModal');
            if (modal) {
                modal.addEventListener('hidden.bs.modal', function () {
                    if (btnClear) btnClear.click();
                });
            }


            document.querySelectorAll('[id^="err_"]').forEach(function (el) {
                el.style.display = 'none';
            });


            function attachBlur(inputId, errId, label, customFn) {
                const el = document.getElementById(inputId);
                if (!el) return;

                el.addEventListener('blur', function () {
                    customFn ? customFn() : validateRequired(inputId, errId, label);
                });


                el.addEventListener('input', function () {
                    if (el.style.border.includes('dc3545')) {
                        customFn ? customFn() : validateRequired(inputId, errId, label);
                    }
                });
            }

            // Column 1
            attachBlur('txtCustomerCode', 'err_CustCode', 'Customer Code');
            attachBlur('txtCustomerName', 'err_CustName', 'Customer Name');
            attachBlur('txtGSTIN', 'err_GSTIN', 'GSTIN', validateGSTIN);
            attachBlur('txtAMCDate', 'err_AMCDate', 'AMC Date');
            attachBlur('txtRegisteredDate', 'err_RegDate', 'Registered Date');

            // Column 2
            attachBlur('txtExpDate', 'err_ExpDate', 'Expiry Date');
            attachBlur('txtVersion', 'err_Version', 'Version');

            // Column 3
            attachBlur('txtClients', 'err_NoofClients', 'No. of Clients',
                function () { validateNumberOnly('txtClients', 'err_NoofClients', 'No. of Clients'); });
            attachBlur('txtMobileApp', 'err_MobileApp', 'Mobile App',
                function () { validateNumberOnly('txtMobileApp', 'err_MobileApp', 'Mobile App'); });
            attachBlur('txtParentComp', 'err_CompCode', 'Parent Comp Code');
            attachBlur('txtGeo', 'err_GeoLocation', 'Geo Location');
            attachBlur('txtAddress', 'err_Address', 'Address');



            function blockNonNumeric(inputId, errId, label) {
                const el = document.getElementById(inputId);
                if (!el) return;

                // Block letters & special chars on keypress
                el.addEventListener('keypress', function (e) {
                    if (!/[0-9]/.test(e.key)) {
                        e.preventDefault();
                        showErr(errId, label + ' — numbers only, no letters or special characters');
                        setError(inputId);
                    }
                });

                // Block non-numeric paste
                el.addEventListener('paste', function (e) {
                    const pasted = (e.clipboardData || window.clipboardData).getData('text');
                    if (!/^\d+$/.test(pasted)) {
                        e.preventDefault();
                        showErr(errId, label + ' — numbers only, no letters or special characters');
                        setError(inputId);
                    }
                });
            }

            blockNonNumeric('txtClients', 'err_NoofClients', 'No. of Clients');
            blockNonNumeric('txtMobileApp', 'err_MobileApp', 'Mobile App');



            const gstinEl = document.getElementById('txtGSTIN');
            if (gstinEl) {
                gstinEl.addEventListener('input', function () {
                    const pos = this.selectionStart;
                    this.value = this.value.toUpperCase();
                    this.setSelectionRange(pos, pos);
                });
            }


            document.querySelectorAll('input[name="shineType"]').forEach(function (r) {
                r.addEventListener('change', function () { hideErr('err_ShineType'); });
            });

            document.querySelectorAll('input[name="userType"]').forEach(function (r) {
                r.addEventListener('change', function () { hideErr('err_UserType'); });
            });

        });
        function GetColumnSettingsData(nMode, nFormID, nTableID) {
            $.ajax({
                url: Aurl + "columnsettings/getcolumnsettings",
                type: 'get',
                contentType: 'json',
                data: { Mode: nMode, FormID: nFormID, TableID: nTableID, FormorReport: 0 },
                async: false,
                success: function (data) {
                    console.log("API Response:", data);
                    console.log("Data length:", data.length); 
                    if (data.length > 0) {
                        CustomerColumns = (data);
                        console.log("columns : ", CustomerColumns);
                        CustomerColumns.push(actions);
                    } else {
                        showErrorSnackbar("No column data found");
                    }
                }
            });
        }
    </script>
