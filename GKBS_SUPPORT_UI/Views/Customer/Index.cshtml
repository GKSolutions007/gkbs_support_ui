                                const gi = gridEl ? gridEl._gkbsGrid : null;
                                if (gi) {
                                    gi.originalData = gi.originalData.filter(r => r !== row);
                                    gi.processData();
                                    gi.render();
                                }
                            }
                        }
                    }
                ]
            });
        }

        function getContactRows() {
            const gridEl = document.querySelector('#grid-Contact-lists');
            const gridInstance = gridEl ? gridEl._gkbsGrid : null;
            if (!gridInstance) return [];
            return gridInstance.originalData
                .map(row => ({
                    Name: row.Name || '',
                    MobileNo: row.MobileNo || '',
                    Owner_Staff: Number(row.Owner_Staff) || 0
                }))
                .filter(r => r.Name.trim() !== '');
        }

        function deleteContact(contactID, customerID) {
            if (!confirm("Delete this contact?")) return;
            $.ajax({
                url: Aurl + "Customer/DeleteContact",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ ID: contactID }),
                success: function (res) {
                    if (res.success) {
                        showSuccessSnackbar("Contact deleted!");
                        loadContacts(customerID);
                    } else {
                        showErrorSnackbar(res.message);
                    }
                }
            });
        }

        function loadContacts(customerID) {
            $.ajax({
                url: Aurl + "Customer/GetContacts",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ CustomerID: customerID }),
                success: function (res) {
                    const rowData = (res.success && res.contacts.length > 0) ? res.contacts : [];
                    loadContactsWithData(rowData);
                },
                error: function (xhr) {
                    showErrorSnackbar("Load contacts error: " + xhr.responseText);
                }
            });
        }

        function previewSelectedFiles(input) {
            const files = Array.from(input.files);

            // ✅ Get existing saved rows (ID > 0 = already in DB)
            const gridEl = document.querySelector('#grid-Attachment-lists');
            const gridInstance = gridEl ? gridEl._gkbsGrid : null;
            const existingRows = gridInstance ? gridInstance.originalData.filter(r => r.ID > 0) : [];

            // ✅ Build preview rows from selected files
            const newRows = files.map(file => ({
                ID: 0,
                FileName: file.name,
                FileType: file.name.split('.').pop().toUpperCase(),
                FileSize: file.size >= 1024 * 1024
                    ? (file.size / (1024 * 1024)).toFixed(1) + ' MB'
                    : (file.size / 1024).toFixed(1) + ' KB',
                UploadedOn: 'Pending...'
            }));

            // ✅ Always re-render — even if both arrays are empty
            const allRows = [...existingRows, ...newRows];

            const attachmentColumns = [
                { field: "FileName", header: "File Name", type: "label", width: 120, align: "left", visible: true, EnableColumnMenu: false, ShowinColumnOption: true },
                { field: "FileType", header: "Type", type: "label", width: 50, align: "left", visible: true, EnableColumnMenu: false, ShowinColumnOption: true },
                { field: "FileSize", header: "Size", type: "label", width: 70, align: "left", visible: true, EnableColumnMenu: false, ShowinColumnOption: true },
                { field: "UploadedOn", header: "Uploaded On", type: "label", width: 90, align: "left", visible: true, EnableColumnMenu: false, ShowinColumnOption: true },
                { field: "Action", header: "Action", type: "action", width: 80, align: "center", visible: true, specialColumn: true, ShowinColumnOption: false, EnableColumnMenu: false }
            ];

            new GKBSDynamicGrid('#grid-Attachment-lists', attachmentColumns, allRows, {
                enablePagination: false,
                enableSearch: false,
                enableExport: false,
                enablePrint: false,
                enableColumnsBtn: false,
                enableAddRow: false,
                enableRemoveRow: false,
                enableSorting: false,
                height: "150px",
                singleIconAction: [
                    {
                        icon: '👁️', title: 'View', displayType: 'single_icon',
                        handler: function (row) {
                            if (row.ID > 0) viewAttachment(row.ID, row.FileName, row.FileType);
                            else showErrorSnackbar('Save first to view!');
                        }
                    },
                    {
                        icon: '⬇️', title: 'Download', displayType: 'single_icon',
                        handler: function (row) {
                            if (row.ID > 0) downloadAttachment(row.ID, row.FileName);
                            else showErrorSnackbar('Save first to download!');
                        }
                    },
                    {
                        icon: '🗑️', title: 'Delete', displayType: 'single_icon',
                        handler: function (row) {
                            if (row.ID > 0) {
                                deleteAttachment(row.ID);
                            } else {
                                // Remove from file input
                                const fileInput = document.getElementById('txtFile');
                                const dt = new DataTransfer();
                                Array.from(fileInput.files).forEach(f => {
                                    if (f.name !== row.FileName) dt.items.add(f);
                                });
                                fileInput.files = dt.files;
                                previewSelectedFiles(fileInput); // ✅ re-render (even if now empty)
                            }
                        }
                    }
                ]
            });
        }

        function fetchAndOpenModal(id, mode) {
            $.ajax({
                url: Aurl + "Customer/GetCustomerByID",
                type: "GET",
                data: { ID: id },
                success: function (res) {
                    if (!res.success) {
                        showErrorSnackbar(res.message || "Failed to load customer.");
                        return;
                    }

                    const row = res.customer;
                    const contacts = res.contacts || [];

                    // ── Populate all fields ──
                    document.getElementById('hdnCustomerID').value = row.ID;
                    document.getElementById('txtCustomerCode').value = row.Customercode || '';
                    document.getElementById('txtCustomerName').value = row.Customername || '';
                    document.getElementById('txtMobNo').value = row.MobileNo || '';
                    document.getElementById('txtEmailID').value = row.EmailID || '';
                    document.getElementById('txtGSTIN').value = row.GSTIN || '';
                    document.getElementById('txtAMCDate').value = row.AmcDate;
                    document.getElementById('txtRegisteredDate').value = row.RegisteredDate;
                    document.getElementById('txtExpDate').value = row.ExpDate;
                    document.getElementById('txtWebExpDate').value = row.WebExpDate;
                    document.getElementById('txtVersion').value = row.Version || '';
                    document.getElementById('txtClients').value = row.NoofClient || '';
                    document.getElementById('txtMobileApp').value = row.MobileApp || '';
                    document.getElementById('txtParentComp').value = row.ParentCompCode || '';
                    document.getElementById('txtAddress').value = row.Address || '';

                    if (row.Latitude && row.Longtitude) {
                        document.getElementById('txtGeo').value = row.Latitude + ', ' + row.Longtitude;
                    }

                    // ShineType — DB stores as bit: 1=FA, 0=Non FA
                    document.querySelectorAll('input[name="shineType"]').forEach(r => r.checked = false);
                    document.querySelector(
                        row.ShineType === '1'
                            ? 'input[name="shineType"][value="FA"]'
                            : 'input[name="shineType"][value="Non FA"]'
                    ).checked = true;

                    // UserType — DB stores as bit: 1=Single, 0=Multi
                    document.querySelectorAll('input[name="userType"]').forEach(r => r.checked = false);
                    document.querySelector(
                        row.Usertype === '1'
                            ? 'input[name="userType"][value="Single"]'
                            : 'input[name="userType"][value="Multi"]'
                    ).checked = true;

                    // Active
                    const chkActive = document.getElementById('chkActive');
                    chkActive.checked = (row.Active === '1' || row.Active === 'True');

                    // Load contacts and attachments from API (fresh data)
                    loadContactsWithData(contacts);
                    loadAttachments(row.ID);

                    // ── MODE SPECIFIC ──
                    const allFields = [
                        'txtCustomerCode', 'txtCustomerName', 'txtGSTIN', 'txtAMCDate',
                        'txtRegisteredDate', 'txtExpDate', 'txtVersion', 'txtClients',
                        'txtMobileApp', 'txtParentComp', 'txtAddress', 'txtGeo',
                        'txtWebExpDate', 'txtMobNo', 'txtEmailID'
                    ];

                    if (mode === 'edit') {
                        TransMode = 2;
                        $("#spMapNavigate").hide();
                        $("#spMapMark").show();
                        document.querySelector('.modal-title').textContent = 'Edit Customer';

                        allFields.forEach(id => { const el = document.getElementById(id); if (el) el.disabled = false; });
                        document.querySelectorAll('input[name="shineType"], input[name="userType"]').forEach(r => r.disabled = false);

                        chkActive.disabled = false;
                        document.getElementById('btnSave').style.display = 'block';
                        document.getElementById('btnClear').style.display = 'block';
                        document.getElementById('btnAddContact').style.display = 'block';

                    } else if (mode === 'view') {
                        TransMode = 3;
                        $("#spMapNavigate").show();
                        $("#spMapMark").hide();
                        document.querySelector('.modal-title').textContent = 'View Customer';

                        allFields.forEach(id => { const el = document.getElementById(id); if (el) el.disabled = true; });
                        document.querySelectorAll('input[name="shineType"], input[name="userType"]').forEach(r => r.disabled = true);

                        chkActive.disabled = true;
                        document.getElementById('btnSave').style.display = 'none';
                        document.getElementById('btnClear').style.display = 'none';
                        document.getElementById('btnAddContact').style.display = 'none';
                    }

                    addModal.show();
                },
                error: function (xhr) {
                    showErrorSnackbar("Failed to load customer: " + xhr.responseText);
                }
            });
        }



        function validateAll() {
            let ok = true;

            // Column 1
            if (!validateRequired('txtCustomerCode', 'err_CustCode', 'Customer Code')) ok = false;
            if (!validateRequired('txtCustomerName', 'err_CustName', 'Customer Name')) ok = false;
            if (!validateGSTIN()) ok = false;
            if (!validateMobileNo()) ok = false;
            if (!EmailValidation($("#txtEmailID"), "#err_EmailID", false)) {
                showErr("err_EmailID", 'Email ID is required');
                setError("txtEmailID");
                ok = false;
            } else {
                hideErr("err_EmailID");
                setValid("txtEmailID");
            }
            if (!validateRequired('txtAMCDate', 'err_AMCDate', 'AMC Date')) ok = false;
            if (!validateRequired('txtRegisteredDate', 'err_RegDate', 'Registered Date')) ok = false;

            // Column 2
            if (!validateRequired('txtExpDate', 'err_ExpDate', 'Expiry Date')) {
                ok = false;
            }
            if (!validateRequired('txtWebExpDate', 'err_WebExpDate', 'Web Expiry Date')) ok = false;

            if (!validateRequired('txtVersion', 'err_Version', 'Version')) ok = false;
            if (!validateRadio('shineType', 'err_ShineType', 'Shine Type')) ok = false;
            if (!validateRadio('userType', 'err_UserType', 'User Type')) ok = false;

            // Column 3
            if (!validateNumberOnly('txtClients', 'err_NoofClients', 'No. of Clients')) ok = false;
            if (!validateNumberOnly('txtMobileApp', 'err_MobileApp', 'Mobile App')) ok = false;
            //if (!validateRequired('txtParentComp', 'err_CompCode', 'Parent Comp Code')) ok = false;
            if (!validateRequired('txtGeo', 'err_GeoLocation', 'Geo Location')) ok = false;
            if (!validateRequired('txtAddress', 'err_Address', 'Address')) ok = false;

            if (!ok) {

                const firstErr = document.querySelector('[id^="err_"]');
                if (firstErr) {
                    const allErrs = Array.from(document.querySelectorAll('[id^="err_"]'))
                        .find(e => e.style.display === 'block');
                    if (allErrs) allErrs.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }

            return ok;
        }


        document.addEventListener('DOMContentLoaded', function () {

            const btnClear = document.getElementById('btnClear');
            if (btnClear) {
                btnClear.addEventListener('click', function () {


                    ['txtCustomerCode', 'txtCustomerName', 'txtGSTIN', 'txtVersion',
                        'txtParentComp', 'txtGeo', 'txtAddress', "txtEmailID", "txtMobNo"
                    ].forEach(function (id) {
                        const el = document.getElementById(id);
                        if (el) { el.value = ''; clearBorder(id); }
                    });
                    //set default date
                    setDefaultDate();
                    //set default value
                    document.getElementById("txtClients").value = 1;
                    document.getElementById("txtMobileApp").value = 0;
                    // Clear radios
                    document.querySelector('input[name="shineType"][value="Non FA"]').checked = true;
                    document.querySelector('input[name="userType"][value="Single"]').checked = true;

                    // Clear file input
                    const fileEl = document.getElementById('txtFile');
                    if (fileEl) fileEl.value = '';

                    // Uncheck Active
                    const chk = document.getElementById('chkActive');
                    const isAddMode = document.getElementById('hdnCustomerID').value === "0";
                    if (chk) {
                        if (isAddMode) {
                            chk.checked = true;
                            chk.disabled = true;
                        } else {
                            chk.checked = false;
                            chk.disabled = false;
                        }
                    }

                    // Hide all error messages
                    document.querySelectorAll('[id^="err_"]').forEach(function (el) {
                        el.style.display = 'none';
                    });
                });
            }


            const modal = document.getElementById('addCustomerModal');
            if (modal) {
                modal.addEventListener('hidden.bs.modal', function () {
                    if (btnClear) btnClear.click();
                });
            }


            document.querySelectorAll('[id^="err_"]').forEach(function (el) {
                el.style.display = 'none';
            });


            function attachBlur(inputId, errId, label, customFn) {
                const el = document.getElementById(inputId);
                if (!el) return;

                el.addEventListener('blur', function () {
                    customFn ? customFn() : validateRequired(inputId, errId, label);
                });


                el.addEventListener('input', function () {
                    if (el.style.border.includes('dc3545')) {
                        customFn ? customFn() : validateRequired(inputId, errId, label);
                    }
                });
            }

            // Column 1
            attachBlur('txtCustomerCode', 'err_CustCode', 'Customer Code');
            attachBlur('txtCustomerName', 'err_CustName', 'Customer Name');
            attachBlur('txtGSTIN', 'err_GSTIN', 'GSTIN', validateGSTIN);
            attachBlur('txtAMCDate', 'err_AMCDate', 'AMC Date');
            attachBlur('txtRegisteredDate', 'err_RegDate', 'Registered Date');

            // Column 2
            attachBlur('txtExpDate', 'err_ExpDate', 'Expiry Date');
            attachBlur('txtWebExpDate', 'err_WebExpDate', 'Web Expiry Date');

            attachBlur('txtVersion', 'err_Version', 'Version');

            // Column 3
            attachBlur('txtClients', 'err_NoofClients', 'No. of Clients',
                function () { validateNumberOnly('txtClients', 'err_NoofClients', 'No. of Clients'); });
            attachBlur('txtMobileApp', 'err_MobileApp', 'Mobile App',
                function () { validateNumberOnly('txtMobileApp', 'err_MobileApp', 'Mobile App'); });
            attachBlur('txtParentComp', 'err_CompCode', 'Parent Comp Code');
            attachBlur('txtGeo', 'err_GeoLocation', 'Geo Location');
            attachBlur('txtAddress', 'err_Address', 'Address');



            function blockNonNumeric(inputId, errId, label) {
                const el = document.getElementById(inputId);
                if (!el) return;

                // Block letters & special chars on keypress
                el.addEventListener('keypress', function (e) {
                    if (!/[0-9]/.test(e.key)) {
                        e.preventDefault();
                        showErr(errId, label + ' — numbers only, no letters or special characters');
                        setError(inputId);
                    }
                });

                // Block non-numeric paste
                el.addEventListener('paste', function (e) {
                    const pasted = (e.clipboardData || window.clipboardData).getData('text');
                    if (!/^\d+$/.test(pasted)) {
                        e.preventDefault();
                        showErr(errId, label + ' — numbers only, no letters or special characters');
                        setError(inputId);
                    }
                });
            }

            blockNonNumeric('txtClients', 'err_NoofClients', 'No. of Clients');
            blockNonNumeric('txtMobileApp', 'err_MobileApp', 'Mobile App');



            const gstinEl = document.getElementById('txtGSTIN');
            if (gstinEl) {
                gstinEl.addEventListener('input', function () {
                    const pos = this.selectionStart;
                    this.value = this.value.toUpperCase();
                    this.setSelectionRange(pos, pos);
                });
            }


            document.querySelectorAll('input[name="shineType"]').forEach(function (r) {
                r.addEventListener('change', function () { hideErr('err_ShineType'); });
            });

            document.querySelectorAll('input[name="userType"]').forEach(function (r) {
                r.addEventListener('change', function () { hideErr('err_UserType'); });
            });

        });
        function GetColumnSettingsData(nMode, nFormID, nTableID) {
            $.ajax({
                url: Aurl + "columnsettings/getcolumnsettings",
                type: 'get',
                contentType: 'json',
                data: { Mode: nMode, FormID: nFormID, TableID: nTableID, FormorReport: 0 },
                async: false,
                success: function (data) {
                    console.log("API Response:", data);
                    console.log("Data length:", data.length);
                    if (data.length > 0) {
                        CustomerColumns = (data);
                        console.log("columns : ", CustomerColumns);
                        CustomerColumns.push(actions);
                    } else {
                        showErrorSnackbar("No column data found");
                    }
                }
            });
        }
    </script>
</body>
