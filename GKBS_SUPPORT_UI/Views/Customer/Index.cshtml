        //document.getElementById('txtEmailID').value = row.EmailID || '';
        function validateMobileNo() {
            hideErr('err_MobNo');
            setValid('txtMobNo');
            var strMobNoRegex = /^([[0-9]{10,12})+$/;
            const el = document.getElementById('txtMobNo');
            if (!el) return true;
            const val = el.value.trim().toUpperCase();

            if (val.length > 0) {
                if (!strMobNoRegex.test(val)) {
                    showErr('err_MobNo', 'Invalid Mobile No format');
                    setError('txtMobNo');
                    return false;
                }
            }
            return true;
        }

        function validateGSTIN() {
            const el = document.getElementById('txtGSTIN');
            if (!el) return true;
            const val = el.value.trim().toUpperCase();
            hideErr('err_GSTIN');
            setValid('txtGSTIN');
            if (val.length > 0) {
                if (val.length !== 15) {
                    showErr('err_GSTIN', 'GSTIN must be exactly 15 characters');
                    setError('txtGSTIN');
                    return false;
                }
                if (!GSTIN_REGEX.test(val)) {
                    showErr('err_GSTIN', 'Invalid GSTIN format — e.g. 22AAAAA0000A1Z5');
                    setError('txtGSTIN');
                    return false;
                }
            }
            return true;
        }

